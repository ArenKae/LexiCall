<Window x:Class="LexiCall.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LexiCall.Desktop"
        xmlns:viewModels="clr-namespace:LexiCall.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="LexiCall" Height="740" Width="1180"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI">
    <!--
        Fenêtre principale organisée autour des catégories :
        arbre de navigation à gauche (avec CRUD contextuel), liste filtrée par
        catégorie + recherche au centre, détail du mot sélectionné à droite.
    -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="4,0,4,18">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Content="{Binding ThemeToggleText}"
                        Style="{StaticResource GhostButtonStyle}"
                        Margin="0,0,12,0"
                        Click="ThemeToggleButton_Click"
                        ToolTip="Bascule entre le thème clair et le thème sombre." />
                <Button Content="Ajouter un mot"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="18,9"
                        Click="AddEntryButton_Click"
                        ToolTip="Ouvre le formulaire d'ajout." />
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Mon vocabulaire"
                           FontSize="26"
                           FontWeight="SemiBold" />
                <TextBlock Text="Organise et retrouve tes mots par catégorie."
                           Margin="0,2,0,0"
                           Foreground="{DynamicResource Brush.Text.Secondary}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═══ Panneau des catégories ═══ -->
            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="6,2,2,8">
                        <Button DockPanel.Dock="Right"
                                Content="＋"
                                FontSize="15"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="7,2"
                                Click="AddRootCategoryButton_Click"
                                ToolTip="Créer une catégorie." />
                        <TextBlock Text="Catégories"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <TreeView Grid.Row="1"
                              x:Name="CategoryTreeView"
                              ItemsSource="{Binding CategoryTree}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              KeyDown="CategoryTreeView_KeyDown">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type viewModels:CategoryNodeViewModel}"
                                                      ItemsSource="{Binding Children}">
                                <Grid Background="Transparent"
                                      ToolTip="{Binding DescriptionToolTip}"
                                      ContextMenuOpening="CategoryNode_ContextMenuOpening">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Nouvelle sous-catégorie…"
                                                      Click="AddSubCategoryMenuItem_Click" />
                                            <MenuItem Header="Renommer"
                                                      InputGestureText="F2"
                                                      Click="RenameCategoryMenuItem_Click" />
                                            <MenuItem Header="Modifier…"
                                                      Click="EditCategoryMenuItem_Click" />
                                            <Separator />
                                            <MenuItem Header="Supprimer"
                                                      Click="DeleteCategoryMenuItem_Click" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DisplayName}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Renommage inline : Entrée valide, Échap annule. -->
                                    <TextBox Grid.Column="0"
                                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="4,1"
                                             Margin="0,-2,4,-2"
                                             Loaded="RenameTextBox_Loaded"
                                             KeyDown="RenameTextBox_KeyDown"
                                             LostFocus="RenameTextBox_LostFocus">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <Border Grid.Column="1"
                                            Background="{DynamicResource Brush.Chip.Neutral.Background}"
                                            CornerRadius="8"
                                            Padding="7,1"
                                            Margin="6,0,2,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding EntryCount}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Brush.Chip.Neutral.Foreground}" />
                                    </Border>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- ═══ Recherche et liste des mots ═══ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Recherche dans les mots, définitions, notes, exemples, catégories et tags." />

                <Grid Grid.Row="1" Margin="4,8,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding SelectedCategoryLabel}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding SearchStatusText}"
                               Margin="8,0,0,0"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               FontSize="12" />
                </Grid>

                <Border Grid.Row="2"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="6">
                    <Grid>
                        <ListBox ItemsSource="{Binding FilteredEntries}"
                                 SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Word}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold" />
                                        <!--
                                            LineStackingStrategy fige la hauteur de chaque ligne :
                                            MaxHeight = 3 lignes exactement, jamais de ligne rognée.
                                        -->
                                        <TextBlock Text="{Binding Definition}"
                                                   Margin="0,3,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   LineHeight="16"
                                                   LineStackingStrategy="BlockLineHeight"
                                                   MaxHeight="48" />

                                        <ItemsControl Margin="0,6,0,0">
                                            <ItemsControl.ItemsSource>
                                                <MultiBinding Converter="{StaticResource CategoryNamesConverter}">
                                                    <Binding Path="CategoryIds" />
                                                    <Binding Path="DataContext.Categories"
                                                             RelativeSource="{RelativeSource AncestorType=Window}" />
                                                </MultiBinding>
                                            </ItemsControl.ItemsSource>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,5,4"
                                                            Padding="7,2"
                                                            Background="{DynamicResource Brush.Chip.Accent.Background}"
                                                            CornerRadius="9">
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource Brush.Chip.Accent.Foreground}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{Binding Source}"
                                                   Margin="0,4,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   Opacity="0.8"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="{Binding EmptyListMessage}"
                                   Width="240"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFilteredEntries}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ Détail du mot sélectionné ═══ -->
            <Border Grid.Column="4"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="26">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="Détails"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   FontWeight="SemiBold" />

                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="Modifier"
                                    Width="96"
                                    Margin="0,0,10,0"
                                    Click="EditEntryButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedEntry}" Value="{x:Null}">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Supprimer"
                                    Width="96"
                                    Foreground="{DynamicResource Brush.Danger}"
                                    Click="DeleteEntryButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedEntry}" Value="{x:Null}">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedEntry}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <ContentControl Content="{Binding SelectedEntry}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Word}"
                                                   FontSize="30"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Definition}"
                                                   Margin="0,10,0,0"
                                                   FontSize="16"
                                                   TextWrapping="Wrap" />

                                        <!-- Les catégories en tête : c'est l'axe d'organisation principal. -->
                                        <ItemsControl ItemsSource="{Binding DataContext.SelectedEntryCategoryNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      Margin="0,14,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,8,8"
                                                            Padding="10,4"
                                                            Background="{DynamicResource Brush.Chip.Accent.Background}"
                                                            CornerRadius="12">
                                                        <TextBlock Text="{Binding}"
                                                                   Foreground="{DynamicResource Brush.Chip.Accent.Foreground}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Separator Margin="0,16,0,20" />

                                        <TextBlock Text="Synonymes"
                                                   FontWeight="SemiBold" />
                                        <ItemsControl ItemsSource="{Binding Synonyms}"
                                                      Margin="0,8,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,8,8"
                                                            Padding="9,4"
                                                            Background="{DynamicResource Brush.Chip.Neutral.Background}"
                                                            CornerRadius="12">
                                                        <TextBlock Text="{Binding}"
                                                                   Foreground="{DynamicResource Brush.Chip.Neutral.Foreground}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="Exemples"
                                                   Margin="0,16,0,0"
                                                   FontWeight="SemiBold" />
                                        <ItemsControl ItemsSource="{Binding ExampleSentences}"
                                                      Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               Margin="0,0,0,8"
                                                               FontStyle="Italic"
                                                               TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="Notes personnelles"
                                                   Margin="0,16,0,0"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Notes}"
                                                   Margin="0,8,0,0"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Text="Source"
                                                   Margin="0,16,0,0"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Source}"
                                                   Margin="0,8,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="1"
                               Text="{Binding EmptyDetailMessage}"
                               Width="360"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedEntry}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
