<Window x:Class="LexiCall.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LexiCall.Desktop"
        xmlns:viewModels="clr-namespace:LexiCall.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="LexiCall" Height="760" Width="1260"
        MinHeight="620" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI">
    <!--
        Fenêtre principale organisée autour des catégories :
        arbre de navigation à gauche (avec CRUD contextuel), liste filtrée par
        catégorie + recherche au centre, détail du mot sélectionné à droite.
    -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="4,0,4,18">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Content="{Binding ThemeToggleText}"
                        Style="{StaticResource GhostButtonStyle}"
                        Margin="0,0,12,0"
                        Click="ThemeToggleButton_Click"
                        ToolTip="Bascule entre le thème clair et le thème sombre." />
                <Button Content="Ajouter un mot"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="18,9"
                        Click="AddEntryButton_Click"
                        ToolTip="Ouvre le formulaire d'ajout." />
            </StackPanel>

            <StackPanel>
                <TextBlock Text="LexiCall"
                           FontSize="26"
                           FontWeight="SemiBold" />
                <TextBlock Text="Organisation et recherche de vocabulaire par catégorie."
                           Margin="0,2,0,0"
                           Foreground="{DynamicResource Brush.Text.Secondary}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="220" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="330" MinWidth="240" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Poignées de redimensionnement : les catégories réelles ont des noms
                 longs, aucune largeur fixe ne convient à tous les cas. -->
            <GridSplitter Grid.Column="1"
                          Width="12"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext" />
            <GridSplitter Grid.Column="3"
                          Width="12"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext" />

            <!-- ═══ Panneau des catégories ═══ -->
            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="6,2,2,8">
                        <Button DockPanel.Dock="Right"
                                Content="＋"
                                FontSize="15"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="7,2"
                                Click="AddRootCategoryButton_Click"
                                ToolTip="Créer une catégorie." />
                        <TextBlock Text="Catégories"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <TreeView Grid.Row="1"
                              x:Name="CategoryTreeView"
                              ItemsSource="{Binding CategoryTree}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              KeyDown="CategoryTreeView_KeyDown">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type viewModels:CategoryNodeViewModel}"
                                                      ItemsSource="{Binding Children}">
                                <Grid ToolTip="{Binding DescriptionToolTip}"
                                      ContextMenuOpening="CategoryNode_ContextMenuOpening">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Nouvelle sous-catégorie…"
                                                      Click="AddSubCategoryMenuItem_Click" />
                                            <MenuItem Header="Renommer"
                                                      InputGestureText="F2"
                                                      Click="RenameCategoryMenuItem_Click" />
                                            <MenuItem Header="Modifier…"
                                                      Click="EditCategoryMenuItem_Click" />
                                            <MenuItem Header="Supprimer"
                                                      Click="DeleteCategoryMenuItem_Click" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>

                                    <!-- Halo de fond : identifie d'un coup d'œil la famille de catégorie
                                         en parcourant la liste, sans nuire à la lisibilité du texte. -->
                                    <Border Grid.Column="0" Grid.ColumnSpan="3"
                                            CornerRadius="4"
                                            Margin="-4,-1,-4,-1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{Binding ColorIndex, Converter={StaticResource CategoryColorConverter}}" />
                                                <Setter Property="Opacity" Value="0.14" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Depth}" Value="0">
                                                        <Setter Property="Opacity" Value="0.22" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsVirtual}" Value="True">
                                                        <Setter Property="Opacity" Value="0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <!-- Repère de couleur plein : la sous-catégorie reprend la teinte de sa
                                         racine, atténuée, pour montrer son appartenance. -->
                                    <Border Grid.Column="0"
                                            CornerRadius="2"
                                            Margin="0,1,4,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{Binding ColorIndex, Converter={StaticResource CategoryColorConverter}}" />
                                                <Setter Property="Opacity" Value="0.5" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Depth}" Value="0">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsVirtual}" Value="True">
                                                        <Setter Property="Opacity" Value="0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <!-- Icône (emoji) : repère visuel qui aide à mémoriser la
                                             catégorie d'un coup d'œil, en complément de la couleur. -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DisplayIcon}"
                                                   FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI"
                                                   FontSize="13"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Margin" Value="4,1,4,1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Depth}" Value="0">
                                                            <Setter Property="Margin" Value="4,3,4,3" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DisplayName}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Margin" Value="0,1,0,1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Depth}" Value="0">
                                                            <Setter Property="Margin" Value="0,3,0,3" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Renommage inline : Entrée valide, Échap annule. -->
                                    <TextBox Grid.Column="1"
                                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="4,1"
                                             Margin="2,-2,4,-2"
                                             IsVisibleChanged="RenameTextBox_IsVisibleChanged"
                                             KeyDown="RenameTextBox_KeyDown"
                                             LostFocus="RenameTextBox_LostFocus">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <Border Grid.Column="2"
                                            Background="{DynamicResource Brush.Chip.Neutral.Background}"
                                            CornerRadius="8"
                                            Padding="7,1"
                                            VerticalAlignment="Top">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Margin" Value="6,1,2,1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Depth}" Value="0">
                                                        <Setter Property="Margin" Value="6,3,2,3" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding EntryCount}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Brush.Chip.Neutral.Foreground}" />
                                    </Border>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- ═══ Recherche et liste des mots ═══ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBox x:Name="SearchTextBox"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Recherche dans les mots, définitions, notes, exemples, catégories et tags.">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Padding" Value="36,6,40,6" />
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="Padding" Value="9,6,40,6" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Loupe discrète : purement décorative, ne capte pas le clic, et
                         cède la place au curseur pendant que le champ a le focus. -->
                    <Canvas Width="14" Height="14"
                            Margin="15,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Opacity="0.55"
                            IsHitTestVisible="False">
                        <Canvas.Style>
                            <Style TargetType="Canvas">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchTextBox}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Canvas.Style>
                        <Ellipse Canvas.Left="0" Canvas.Top="0"
                                 Width="9" Height="9"
                                 Stroke="{DynamicResource Brush.Text.Secondary}"
                                 StrokeThickness="1.4" />
                        <Line X1="8" Y1="8" X2="13" Y2="13"
                              Stroke="{DynamicResource Brush.Text.Secondary}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Canvas>

                    <!-- Croix d'effacement : visible seulement si la recherche n'est pas vide. -->
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="18" Height="18"
                            Margin="0,0,15,0"
                            Padding="0"
                            Focusable="False"
                            Click="ClearSearchButton_Click"
                            ToolTip="Effacer la recherche">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Canvas Width="8" Height="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Line X1="0" Y1="0" X2="8" Y2="8"
                                  Stroke="{DynamicResource Brush.Text.Secondary}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                            <Line X1="8" Y1="0" X2="0" Y2="8"
                                  Stroke="{DynamicResource Brush.Text.Secondary}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Canvas>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="4,8,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding SelectedCategoryLabel}"
                               ToolTip="{Binding SelectedCategoryTooltip}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding SearchStatusText}"
                               Margin="8,0,0,0"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               FontSize="12" />
                </Grid>

                <Border Grid.Row="2"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="6">
                    <Grid>
                        <ListBox ItemsSource="{Binding FilteredEntries}"
                                 SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <!-- Layout compact : priorité au nombre de mots visibles sans défiler. -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="8,4" />
                                    <Setter Property="Margin" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Word}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />

                                        <ItemsControl Margin="0,2,0,0">
                                            <ItemsControl.ItemsSource>
                                                <MultiBinding Converter="{StaticResource CategoryNamesConverter}">
                                                    <Binding Path="CategoryIds" />
                                                    <Binding Path="DataContext.Categories"
                                                             RelativeSource="{RelativeSource AncestorType=Window}" />
                                                </MultiBinding>
                                            </ItemsControl.ItemsSource>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,4,2"
                                                            Padding="6,1"
                                                            Background="{DynamicResource Brush.Chip.Accent.Background}"
                                                            CornerRadius="8">
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource Brush.Chip.Accent.Foreground}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{Binding Source}"
                                                   Margin="0,2,0,0"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   Opacity="0.8"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="{Binding EmptyListMessage}"
                                   Width="240"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFilteredEntries}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ Détail du mot sélectionné ═══ -->
            <Border Grid.Column="4"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="26">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="Détails"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   FontWeight="SemiBold" />

                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="Modifier"
                                    Width="96"
                                    Margin="0,0,10,0"
                                    Click="EditEntryButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedEntry}" Value="{x:Null}">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Supprimer"
                                    Width="96"
                                    Foreground="{DynamicResource Brush.Danger}"
                                    Click="DeleteEntryButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedEntry}" Value="{x:Null}">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedEntry}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <ContentControl Content="{Binding SelectedEntry}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Word}"
                                                   FontSize="30"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Definition}"
                                                   Margin="0,10,0,0"
                                                   FontSize="16"
                                                   TextWrapping="Wrap" />

                                        <!-- Les catégories en tête : c'est l'axe d'organisation principal. -->
                                        <ItemsControl ItemsSource="{Binding DataContext.SelectedEntryCategoryNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      Margin="0,14,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,8,8"
                                                            Padding="10,4"
                                                            Background="{DynamicResource Brush.Chip.Accent.Background}"
                                                            CornerRadius="12">
                                                        <TextBlock Text="{Binding}"
                                                                   Foreground="{DynamicResource Brush.Chip.Accent.Foreground}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Separator Margin="0,16,0,20" />

                                        <TextBlock Text="Synonymes"
                                                   FontWeight="SemiBold" />
                                        <ItemsControl ItemsSource="{Binding Synonyms}"
                                                      Margin="0,8,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,8,8"
                                                            Padding="9,4"
                                                            Background="{DynamicResource Brush.Chip.Neutral.Background}"
                                                            CornerRadius="12">
                                                        <TextBlock Text="{Binding}"
                                                                   Foreground="{DynamicResource Brush.Chip.Neutral.Foreground}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="Exemples"
                                                   Margin="0,16,0,0"
                                                   FontWeight="SemiBold" />
                                        <ItemsControl ItemsSource="{Binding ExampleSentences}"
                                                      Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               Margin="0,0,0,8"
                                                               FontStyle="Italic"
                                                               TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="Notes personnelles"
                                                   Margin="0,16,0,0"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Notes}"
                                                   Margin="0,8,0,0"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Text="Source"
                                                   Margin="0,16,0,0"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Source}"
                                                   Margin="0,8,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="1"
                               Text="{Binding EmptyDetailMessage}"
                               Width="360"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedEntry}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
