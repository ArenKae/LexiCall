<Window x:Class="LexiCall.Desktop.CategoryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="520" Width="520"
        MinHeight="500" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI">
    <!--
        Formulaire modal d'ajout/modification d'une catégorie.
        Le renommage rapide se fait directement dans l'arbre de la fenêtre
        principale ; cette fenêtre sert à la création et aux changements de
        parent ou de description.
    -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding HeaderText}"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding DescriptionText}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,18"
                Padding="20"
                Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Nom *"
                           FontWeight="SemiBold" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center" />

                    <!-- Sélecteur d'icône : ouvre IconPickerWindow, qui referme
                         aussitôt qu'une icône est choisie. -->
                    <Button Grid.Column="1"
                            Width="44" Height="36"
                            Padding="0"
                            Margin="8,0,0,0"
                            Click="ChooseIconButton_Click"
                            ToolTip="Choisir une icône pour cette catégorie.">
                        <TextBlock Text="{Binding IconDisplayGlyph}"
                                   FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI"
                                   FontSize="18" />
                    </Button>

                    <Button Grid.Column="2"
                            Width="28" Height="36"
                            Padding="0"
                            Margin="4,0,0,0"
                            Click="ClearIconButton_Click"
                            ToolTip="Retirer l'icône">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="✕" FontSize="10" />
                    </Button>
                </Grid>

                <TextBlock Text="Catégorie parente"
                           Margin="0,14,0,0"
                           FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding ParentOptions}"
                          SelectedItem="{Binding SelectedParentOption, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          Margin="0,6,0,0" />

                <TextBlock Text="Description"
                           Margin="0,14,0,0"
                           FontWeight="SemiBold" />
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,6,0,0"
                         Height="72"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" />

                <TextBlock Text="{Binding ErrorMessage}"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Danger}"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Annuler"
                    Width="96"
                    Margin="0,0,10,0"
                    IsCancel="True" />
            <Button Content="{Binding SaveButtonText}"
                    Width="110"
                    Style="{StaticResource AccentButtonStyle}"
                    IsDefault="True"
                    Command="{Binding SaveCategoryCommand}" />
        </StackPanel>
    </Grid>
</Window>
