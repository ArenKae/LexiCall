<Window x:Class="LexiCall.Desktop.EntryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="620" Width="760"
        MinHeight="560" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI">
    <!--
        Formulaire modal d'ajout/modification d'une entrée.
        Les catégories sont optionnelles et sélectionnées par cases à cocher,
        indentées selon leur profondeur dans la hiérarchie.
    -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding HeaderText}"
                       FontSize="26"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding DescriptionText}"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,20,0,20"
                Padding="20"
                Style="{StaticResource CardBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Mot *"
                               FontWeight="SemiBold" />
                    <TextBox Grid.Row="1"
                             Grid.Column="0"
                             Margin="0,6,0,14"
                             Text="{Binding Word, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Text="Source"
                               FontWeight="SemiBold" />
                    <TextBox Grid.Row="1"
                             Grid.Column="2"
                             Margin="0,6,0,14"
                             Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Définition *"
                               FontWeight="SemiBold" />
                    <TextBox Grid.Row="3"
                             Grid.Column="0"
                             Margin="0,6,0,14"
                             Height="84"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Text="{Binding Definition, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="2"
                               Text="Exemples"
                               FontWeight="SemiBold" />
                    <TextBox Grid.Row="3"
                             Grid.Column="2"
                             Margin="0,6,0,14"
                             Height="84"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Text="{Binding ExampleSentencesText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               Text="Synonymes"
                               FontWeight="SemiBold" />
                    <TextBox Grid.Row="5"
                             Grid.Column="0"
                             Margin="0,6,0,14"
                             Text="{Binding SynonymsText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="4"
                               Grid.Column="2"
                               Text="Catégories"
                               FontWeight="SemiBold" />
                    <Grid Grid.Row="5"
                          Grid.Column="2"
                          Margin="0,6,0,14">
                        <Border BorderBrush="{DynamicResource Brush.Border.Strong}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Background="{DynamicResource Brush.Input.Background}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAvailableCategories}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ListBox ItemsSource="{Binding CategorySelections}"
                                     Height="88"
                                     Padding="6"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Padding" Value="4,3" />
                                        <Setter Property="Margin" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}"
                                                  Margin="{Binding Depth, Converter={StaticResource DepthToIndentConverter}}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <TextBlock Text="Aucune catégorie disponible. Tu peux en créer depuis le panneau latéral de la fenêtre principale."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAvailableCategories}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <TextBlock Grid.Row="6"
                               Grid.Column="0"
                               Text="Notes personnelles"
                               FontWeight="SemiBold" />
                    <TextBox Grid.Row="7"
                             Grid.Column="0"
                             Margin="0,6,0,0"
                             Height="70"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="6"
                               Grid.Column="2"
                               Text="Tags"
                               FontWeight="SemiBold" />
                    <TextBox Grid.Row="7"
                             Grid.Column="2"
                             Margin="0,6,0,0"
                             Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="8"
                               Grid.ColumnSpan="3"
                               Text="{Binding ErrorMessage}"
                               Margin="0,14,0,0"
                               Foreground="{DynamicResource Brush.Danger}"
                               FontWeight="SemiBold" />
                </Grid>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="2">
            <TextBlock Text="Les catégories sont optionnelles. Sépare les synonymes et tags par des virgules."
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Annuler"
                        Width="96"
                        Margin="0,0,10,0"
                        IsCancel="True" />
                <Button Content="{Binding SaveButtonText}"
                        Width="110"
                        Style="{StaticResource AccentButtonStyle}"
                        IsDefault="True"
                        Command="{Binding SaveEntryCommand}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
