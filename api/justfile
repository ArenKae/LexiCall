# Justfile for the FastAPI/MongoDB backend (api/). Dev recipes (local Mongo
# + uvicorn with reload) and production recipes (docker-compose.prod.yml, on the
# VPS) are grouped separately below; the root justfile exposes these with
# an -api suffix.

default:
    just --list

# --------------------------------
# --- dev (docker-compose.yml) ---
# --------------------------------

# Create the venv and install dependencies (runtime + dev).
[group('dev')]
dev-install:
    python3 -m venv .venv
    .venv/bin/pip install -r requirements.txt -r requirements-dev.txt

# Wrapper: start Mongo, then the API, both in dev mode.
[group('dev')]
dev-up: dev-mongo-up dev-run

# Start Mongo alone (dev container, local data). Self-healing: if the
# container's target port (e.g. 27017) was busy at creation time — a stale
# SSH tunnel, another Mongo — Docker can silently create it with no port
# published at all; merely starting it later never fixes that, since port
# bindings are fixed at creation, not re-evaluated on start. Detected via
# `len .NetworkSettings.Ports` (0 means no port published at all) and
# healed with one automatic --force-recreate, which keeps the named volume
# (dev data untouched) and only replaces the container itself.
[group('dev')]
dev-mongo-up:
    #!/usr/bin/env bash
    set -euo pipefail
    docker compose up -d mongo
    container_id=$(docker compose ps -q mongo)
    port_count=$(docker inspect -f '{{{{len .NetworkSettings.Ports}}' "$container_id")
    if [ "$port_count" = "0" ]; then
        echo "Mongo container has no port published (likely created while the port was busy) — recreating..." >&2
        docker compose up -d --force-recreate mongo
    fi

# Run uvicorn with hot reload. HOST defaults to 0.0.0.0 so the API stays
# reachable from the Windows host while running inside the Linux dev VM;
# pass a positional arg to restrict it, e.g. `just dev-run 127.0.0.1`.
# Positional, not NAME=value like make — `just dev-run HOST=127.0.0.1`
# would pass the literal string "HOST=127.0.0.1" as the value.
[group('dev')]
dev-run HOST="0.0.0.0":
    .venv/bin/uvicorn lexicall_api.main:app --reload --app-dir src --env-file .env --host {{HOST}}

# Stop the dev stack.
[group('dev')]
dev-stop:
    docker compose down

# --------------------------------------------
# --- production (docker-compose.prod.yml) ---
# --------------------------------------------

# Build (if needed) and bring the full stack up. Safe to rerun after every
# `git pull` — Compose only rebuilds/recreates services whose image or
# config actually changed.
[group('production')]
prod-deploy:
    docker compose -f docker-compose.prod.yml up -d --build

# Stop the production stack.
[group('production')]
prod-down:
    docker compose -f docker-compose.prod.yml down

# Back up Mongo (deploy/backup.sh script).
[group('production')]
prod-backup:
    ./deploy/backup.sh

# One-off, idempotent vocabulary.json -> Mongo migration (see api/README.md).
[group('production')]
migrate *ARGS:
    PYTHONPATH=src .venv/bin/python -m lexicall_api.migration.migrate_from_json {{ARGS}}

# Interactive mongosh shell, authenticated as the scoped app user — no root
# in this repo, MongoDB is shared infra owned outside it. A disposable
# mongo:8.0 container on the external `lexicall-db` network reaches it;
# nothing here assumes a `mongo` Compose service exists in this project.
[group('production')]
mongosh:
    #!/usr/bin/env bash
    set -euo pipefail
    MONGO_URI=$(grep -oP '(?<=^MONGO_URI=).*' .env)
    docker run --rm -it --network lexicall-db mongo:8.0 mongosh "$MONGO_URI"
