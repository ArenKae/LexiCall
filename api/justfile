default:
    just --list

install:
    python3 -m venv .venv
    .venv/bin/pip install -r requirements.txt -r requirements-dev.txt

# HOST defaults to loopback-only; pass a positional arg to override, e.g.
# `just run 0.0.0.0` to bind to the LAN (needed for a machine other than this
# one, e.g. the Windows host, to reach the API during dev/testing). Note:
# just recipe args are positional, not NAME=value like make — `just run
# HOST=0.0.0.0` would pass the literal string "HOST=0.0.0.0" as the value.
run HOST="127.0.0.1":
    .venv/bin/uvicorn lexicall_api.main:app --reload --app-dir src --env-file .env --host {{HOST}}

clean:
    rm -rf .venv .pytest_cache

migrate *ARGS:
    PYTHONPATH=src .venv/bin/python -m lexicall_api.migration.migrate_from_json {{ARGS}}

# --- dev (docker-compose.yml: Mongo only — the app itself runs via `just run`) ---

dev-mongo-up:
    docker compose up -d mongo

dev-mongo-down:
    docker compose down

# --- prod (docker-compose.prod.yml: API + Mongo, run these on the VPS) ---

# Build (if needed) and bring the full stack up. Safe to rerun after every
# `git pull` — Compose only rebuilds/recreates services whose image or config
# actually changed.
deploy:
    docker compose -f docker-compose.prod.yml up -d --build

down:
    docker compose -f docker-compose.prod.yml down

logs SERVICE="api":
    docker compose -f docker-compose.prod.yml logs -f {{SERVICE}}


backup:
    ./deploy/backup.sh

# Interactive mongosh shell, authenticated as root. Password is read straight
# from .env — never typed or pasted into a masked prompt.
mongo-shell:
    #!/usr/bin/env bash
    set -euo pipefail
    ROOT_PWD=$(grep -oP '(?<=^MONGO_ROOT_PASSWORD=).*' .env)
    docker compose -f docker-compose.prod.yml exec mongo mongosh "mongodb://lexicall_root:${ROOT_PWD}@localhost:27017/admin"
