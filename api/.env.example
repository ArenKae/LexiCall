# Copy to .env and fill in real values.
# Generate a key: python3 -c "import secrets; print(secrets.token_hex(32))"
API_KEY=change-me

# Dev (docker-compose.yml): self-contained, unauthenticated Mongo — the
# default below matches it out of the box.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=lexicall

# Prod uses a different shape instead: MongoDB is shared infra owned outside
# this repo (see the private ops docs), reached through a scoped user with
# readWrite on this app's own database only — never the shared instance's
# root account, e.g.
#   MONGO_URI=mongodb://lexicall_app:<password>@mongo:27017/lexicall?authSource=lexicall
