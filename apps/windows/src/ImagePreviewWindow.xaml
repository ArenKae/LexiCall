<Window x:Class="LexiCall.Desktop.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aperçu de l'image"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">
    <!--
        Aperçu agrandi de l'image d'une entrée, ouvert au clic depuis la colonne
        Détails. MaxWidth/MaxHeight de l'Image sont fixés en code-behind (fraction
        de la zone de travail de l'écran) pour ne jamais déborder même sur les
        images stockées à la résolution maximale (1024 px).
    -->
    <StackPanel Margin="24">
        <Image x:Name="PreviewImage"
               Stretch="Uniform"
               Cursor="Hand"
               MouseLeftButtonUp="PreviewImage_MouseLeftButtonUp" />

        <Button Content="Fermer"
                Width="96"
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                IsCancel="True" />
    </StackPanel>
</Window>
