<!-- Light theme: same brush keys as Colors.Dark.xaml, light values. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.Window.Background" Color="#F5EFE4" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FCFAF4" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#F0E9DA" />
    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="#E4DAC6" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#CBBFA6" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#16213D" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#7A7264" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="#A39880" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFF" />

    <!-- Raw Color (not a Brush): needed wherever a property isn't Brush-typed,
         e.g. the TextBox focus glow's DropShadowEffect.Color in Styles.xaml. -->
    <Color x:Key="Color.Accent">#2F5FA8</Color>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#3A6FBE" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#254A85" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#B42318" />
    <SolidColorBrush x:Key="Brush.Success" Color="#2E7D46" />

    <SolidColorBrush x:Key="Brush.Chip.Neutral.Background" Color="#EDE6D6" />
    <SolidColorBrush x:Key="Brush.Chip.Neutral.Foreground" Color="#5C5546" />

    <!-- Synonym chips: Surface + 5% (subtle overlay, not a distinct "surface" tone). -->
    <SolidColorBrush x:Key="Brush.Chip.Synonym.Background" Color="#EFEEE8" />

    <SolidColorBrush x:Key="Brush.Selection.Background" Color="#DCE7F8" />
    <SolidColorBrush x:Key="Brush.Selection.Foreground" Color="#16213D" />

    <SolidColorBrush x:Key="Brush.Input.Background" Color="#FFFFFF" />

    <!-- Fixed neutral grey for non-colorable vector icons (virtual category
         nodes, "All entries"/"Uncategorized"): same value in both themes, an
         OKLCH grey (L=0.58, C=0) chosen for roughly equal contrast against
         both backgrounds, since category colors themselves aren't
         theme-aware either (see CategoryColorResolver). -->
    <SolidColorBrush x:Key="Brush.Icon.Neutral" Color="#7A7A7A" />

</ResourceDictionary>
