<!--
    Thème sombre. Le fond n'est pas du noir pur : les surfaces gardent un écart
    de luminosité suffisant entre elles pour que les séparations restent
    visibles sur les écrans OLED, complété par des bordures explicites.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.Window.Background" Color="#0B0F17" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#151C28" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#1E2735" />
    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="#2B3444" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#3A4557" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#EDE9DD" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#99A2B1" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#0B1220" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#5C8FD6" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#74A1DF" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#4A7BC2" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#E5695F" />

    <SolidColorBrush x:Key="Brush.Chip.Neutral.Background" Color="#232B39" />
    <SolidColorBrush x:Key="Brush.Chip.Neutral.Foreground" Color="#B7BDC9" />
    <SolidColorBrush x:Key="Brush.Chip.Accent.Background" Color="#21324E" />
    <SolidColorBrush x:Key="Brush.Chip.Accent.Foreground" Color="#A9C6EC" />

    <SolidColorBrush x:Key="Brush.Selection.Background" Color="#263A57" />
    <SolidColorBrush x:Key="Brush.Selection.Foreground" Color="#F0EDE3" />

    <SolidColorBrush x:Key="Brush.Input.Background" Color="#10151F" />

</ResourceDictionary>
