<!-- Thème sombre : mêmes clés de brush que Colors.Light.xaml, valeurs sombres
     inspirées de la palette Discord (gris neutres, texte quasi blanc, accent blurple). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <SolidColorBrush x:Key="Brush.Window.Background" Color="#1E1F22" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#2B2D31" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#35373C" />
    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="#3A3C41" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#4E5058" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#F2F3F5" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#949BA4" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#5865F2" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#707BF5" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#4752C4" />

    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#8991F0" />
    <SolidColorBrush x:Key="Brush.Accent.Soft.Hover" Color="#9AA1F4" />
    <SolidColorBrush x:Key="Brush.Accent.Soft.Pressed" Color="#6D77D6" />
    <SolidColorBrush x:Key="Brush.Text.OnAccentSoft" Color="#12142B" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#ED4245" />
    <SolidColorBrush x:Key="Brush.Success" Color="#3BA55C" />

    <SolidColorBrush x:Key="Brush.Chip.Neutral.Background" Color="#3A3C43" />
    <SolidColorBrush x:Key="Brush.Chip.Neutral.Foreground" Color="#C8CDD3" />

    <SolidColorBrush x:Key="Brush.Selection.Background" Color="#404249" />
    <SolidColorBrush x:Key="Brush.Selection.Foreground" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Brush.Input.Background" Color="#1E1F22" />

    <!-- Opacité du halo de couleur de catégorie dans l'arbre (MainWindow.xaml) :
         voir Colors.Light.xaml, un même mélange alpha se voit déjà bien plus
         sur un fond sombre. -->
    <sys:Double x:Key="Opacity.CategoryHalo">0.14</sys:Double>
    <sys:Double x:Key="Opacity.CategoryHalo.Root">0.22</sys:Double>

</ResourceDictionary>
