<Application x:Class="LexiCall.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:LexiCall.Desktop.Converters"
             StartupUri="MainWindow.xaml">
    <!-- Déclaration de l'application : dictionnaires de thème et converters partagés. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.Light.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:CategoryNamesConverter x:Key="CategoryNamesConverter" />
            <converters:DepthToIndentConverter x:Key="DepthToIndentConverter" />
            <converters:CategoryChipColorConverter x:Key="CategoryChipColorConverter" />
            <converters:Base64ImageConverter x:Key="Base64ImageConverter" />
            <converters:WidthBreakpointConverter x:Key="WidthBreakpointConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
