<Application x:Class="LexiCall.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:LexiCall.Desktop.Converters"
             StartupUri="MainWindow.xaml">
    <!--
        Le dictionnaire de couleurs occupe l'index 0 des MergedDictionaries :
        le ThemeService le remplace à cet index pour basculer clair/sombre.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.Light.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:CategoryNamesConverter x:Key="CategoryNamesConverter" />
            <converters:DepthToIndentConverter x:Key="DepthToIndentConverter" />
            <converters:CategoryColorConverter x:Key="CategoryColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
