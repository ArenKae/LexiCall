<Window x:Class="LexiCall.Desktop.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options"
        SizeToContent="WidthAndHeight"
        MinWidth="380" MaxWidth="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI">
    <!-- Fenêtre d'options (ouverte depuis le bouton rouage de la fenêtre principale) :
         bascule de thème et accès au dossier de données. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Options"
                   FontSize="22"
                   FontWeight="SemiBold" />

        <Border Grid.Row="1"
                Margin="0,18,0,0"
                Padding="16"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Apparence"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Thème clair ou sombre de l'application."
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="{Binding ThemeToggleText}"
                        Style="{StaticResource GhostButtonStyle}"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Click="ThemeToggleButton_Click"
                        ToolTip="Bascule entre le thème clair et le thème sombre." />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="16"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Données"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DataFilePath}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Ouvrir le dossier"
                        Style="{StaticResource GhostButtonStyle}"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Click="OpenDataFolderButton_Click"
                        ToolTip="Ouvre le dossier %LOCALAPPDATA%\LexiCall dans l'Explorateur." />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,22,0,0">
            <Button Content="Fermer"
                    Width="96"
                    IsCancel="True"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
