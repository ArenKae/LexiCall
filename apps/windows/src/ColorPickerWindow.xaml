<Window x:Class="LexiCall.Desktop.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choisir une couleur"
        Height="360" Width="380"
        MinHeight="320" MinWidth="340"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI">
    <!-- Sélecteur de couleur de catégorie : palette fixe (CategoryColorPalette),
         calée sur les mêmes teintes que les couleurs automatiques pour que le
         choix manuel s'y fonde. Cliquer une pastille la sélectionne immédiatement
         (pas de bouton Valider séparé), comme IconPickerWindow. -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Choisir une couleur"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,14" />

        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding Swatches}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Width="40" Height="40"
                            Margin="0,0,10,10"
                            Padding="0"
                            Cursor="Hand"
                            Tag="{Binding}"
                            ToolTip="{Binding}"
                            Click="SwatchButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="20"
                                        Background="{Binding}"
                                        BorderThickness="2"
                                        BorderBrush="{DynamicResource Brush.Border.Strong}" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Grid.Row="2"
                Content="Automatique"
                Margin="0,14,0,0"
                Click="AutomaticButton_Click"
                ToolTip="Revenir à la couleur attribuée automatiquement à cette catégorie." />
    </Grid>
</Window>
