<Window x:Class="LexiCall.Desktop.Windows.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aperçu de l'image"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">
    <!-- Enlarged preview of an entry's image (opened by clicking it in the
         Detail column). MaxWidth/MaxHeight are set in code-behind as a
         fraction of the work area, so it never overflows the screen. -->
    <StackPanel Margin="24">
        <Image x:Name="PreviewImage"
               Stretch="Uniform"
               Cursor="Hand"
               MouseLeftButtonUp="PreviewImage_MouseLeftButtonUp" />

        <Button Content="Fermer"
                Width="96"
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                IsCancel="True" />
    </StackPanel>
</Window>
