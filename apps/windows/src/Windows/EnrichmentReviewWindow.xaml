<Window x:Class="LexiCall.Desktop.Windows.EnrichmentReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enrichissement automatique"
        Height="720" Width="640"
        MinHeight="480" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI"
        Loaded="EnrichmentReviewWindow_Loaded">
    <!-- AI suggestion review -->
    <Window.Resources>
        <!-- Text field card template -->
        <DataTemplate x:Key="TextFieldSuggestionCardTemplate">
            <StackPanel Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding FieldLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1"
                              Content="Appliquer"
                              IsChecked="{Binding IsAccepted, Mode=TwoWay}"
                              VerticalAlignment="Center" />
                </Grid>

                <TextBlock Margin="0,8,0,0"
                           Text="{Binding CurrentValueDisplay}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           FontStyle="Italic">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCurrentValue}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBox Margin="0,8,0,0"
                         MinHeight="60"
                         MaxHeight="160"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         Text="{Binding EditableText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,6,0,0"
                           Text="{Binding Justification}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource Brush.Text.Secondary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasJustification}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Enrichissement automatique"
                       FontSize="26"
                       FontWeight="SemiBold" />
            <TextBlock Text="Des suggestions ont été générées pour cette entrée ; chacune peut être ajustée ou ignorée avant l'enregistrement."
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,20,0,20"
                Padding="20,20,8,20"
                Style="{StaticResource CardBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Padding="0,0,24,0">
                <StackPanel>
                    <!-- Définition has its own block rather than the shared
                         text template: one row per sense, each with a lock
                         excluding it from "Reformuler". -->
                    <StackPanel Margin="0,0,0,20">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DefinitionCard}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Définition" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1"
                                      Content="Appliquer"
                                      IsChecked="{Binding DefinitionCard.IsAccepted, Mode=TwoWay}"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding DefinitionCard.CurrentValueDisplay}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   FontStyle="Italic">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DefinitionCard.HasCurrentValue}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding DefinitionCard.Senses.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="False"
                                                 VerticalContentAlignment="Top"
                                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                                        <ToggleButton Grid.Column="1"
                                                      Margin="6,0,0,0"
                                                      VerticalAlignment="Top"
                                                      Style="{StaticResource FieldLockToggleStyle}"
                                                      ToolTip="Exclure ce sens de la reformulation"
                                                      IsChecked="{Binding IsRephraseLocked, Mode=TwoWay}" />
                                        <Button Grid.Column="2"
                                                Content="✕"
                                                Width="22" Height="22"
                                                Padding="0"
                                                Margin="4,0,0,0"
                                                VerticalAlignment="Top"
                                                ToolTip="Retirer ce sens"
                                                Command="{Binding RemoveCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanRemove}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding DefinitionCard.Senses.AddSenseCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Phosphor.plus}"
                                          Fill="{DynamicResource Brush.Text.Secondary}"
                                          Width="11" Height="11"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0" />
                                    <TextBlock Text="Ajouter un sens" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1"
                                    Padding="10,3"
                                    FontSize="12"
                                    HorizontalAlignment="Right"
                                    ToolTip="Régénère une autre formulation de la même définition"
                                    Command="{Binding DefinitionCard.RephraseCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DefinitionCard.CanRephrase}" Value="False">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="11" Height="11" Stretch="Uniform"
                                          Data="{StaticResource Icon.Phosphor.circle-half-tilt}"
                                          Fill="{DynamicResource Brush.Text.Secondary}"
                                          Margin="0,0,6,0"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="0" />
                                        </Path.RenderTransform>
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DefinitionCard.IsRephrasing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                        <Path.Triggers>
                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                            From="0" To="360" Duration="0:0:0.8"
                                                            RepeatBehavior="Forever" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Path.Triggers>
                                    </Path>
                                    <Path Data="{StaticResource Icon.Phosphor.arrow-clockwise}"
                                          Width="11" Height="11"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Text.Secondary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DefinitionCard.IsRephrasing}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Text="Reformuler" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding DefinitionCard.RephraseErrorMessage}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   TextAlignment="Right"
                                   Foreground="{DynamicResource Brush.Danger}"
                                   FontSize="12"
                                   FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DefinitionCard.HasRephraseError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding DefinitionCard.Justification}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.Text.Secondary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DefinitionCard.HasJustification}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TypeCard}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Type" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1"
                                      Content="Appliquer"
                                      IsChecked="{Binding TypeCard.IsAccepted, Mode=TwoWay}"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding TypeCard.CurrentValueDisplay}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   FontStyle="Italic">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TypeCard.HasCurrentValue}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Grid Margin="0,8,0,0">
                            <ToggleButton x:Name="ReviewTypeToggle"
                                          Style="{StaticResource MultiSelectDropdownToggleStyle}"
                                          Content="{Binding TypeCard.TypeSelections.SelectionSummary}"
                                          IsChecked="{Binding IsOpen, ElementName=ReviewTypePopup, Mode=TwoWay}" />
                            <Popup x:Name="ReviewTypePopup"
                                   PlacementTarget="{Binding ElementName=ReviewTypeToggle}"
                                   Placement="Bottom"
                                   VerticalOffset="4"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource Brush.Surface}"
                                        BorderBrush="{DynamicResource Brush.Border.Strong}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4"
                                        MinWidth="{Binding ActualWidth, ElementName=ReviewTypeToggle}">
                                    <ItemsControl ItemsSource="{Binding TypeCard.TypeSelections.Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Label}"
                                                          Margin="6,4"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Popup>
                        </Grid>

                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding TypeCard.Justification}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.Text.Secondary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TypeCard.HasJustification}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <ContentControl Content="{Binding SynonymsCard}" ContentTemplate="{StaticResource TextFieldSuggestionCardTemplate}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SynonymsCard}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <ContentControl Content="{Binding ExampleSentencesCard}" ContentTemplate="{StaticResource TextFieldSuggestionCardTemplate}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExampleSentencesCard}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="2">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Annuler"
                        Width="96"
                        Margin="0,0,10,0"
                        IsCancel="True" />
                <Button Content="Enregistrer"
                        Width="110"
                        Style="{StaticResource AccentButtonStyle}"
                        IsDefault="True"
                        Command="{Binding SaveCommand}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
