<Window x:Class="LexiCall.Desktop.Windows.EnrichmentReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enrichissement IA"
        Height="720" Width="640"
        MinHeight="480" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI"
        Loaded="EnrichmentReviewWindow_Loaded">
    <!--
        Single review mechanism for every AI enrichment suggestion in the
        app (see EnrichmentReviewWindowViewModel) — one card per field the
        API actually returned a suggestion for; a field the model judged
        locked/already-satisfactory just never gets a card. Each card is
        pre-checked ("Appliquer") and independently correctable before
        Enregistrer is clicked.
    -->
    <Window.Resources>
        <!-- Shared layout for the three text-shaped cards (Définition/
             Synonymes/Exemples) — Type gets its own block below since it's a
             ComboBox choice, not free text. -->
        <DataTemplate x:Key="TextFieldSuggestionCardTemplate">
            <StackPanel Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding FieldLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1"
                              Content="Appliquer"
                              IsChecked="{Binding IsAccepted, Mode=TwoWay}"
                              VerticalAlignment="Center" />
                </Grid>

                <TextBlock Margin="0,8,0,0"
                           Text="{Binding CurrentValueDisplay}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           FontStyle="Italic">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCurrentValue}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBox Margin="0,8,0,0"
                         MinHeight="60"
                         MaxHeight="160"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         Text="{Binding EditableText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,6,0,0"
                           Text="{Binding Justification}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource Brush.Text.Secondary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasJustification}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Enrichissement IA"
                       FontSize="26"
                       FontWeight="SemiBold" />
            <TextBlock Text="Relis les suggestions ci-dessous, corrige-les si besoin, puis choisis lesquelles appliquer."
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,20,0,20"
                Padding="20,20,8,20"
                Style="{StaticResource CardBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Padding="0,0,24,0">
                <StackPanel>
                    <ContentControl Content="{Binding DefinitionCard}" ContentTemplate="{StaticResource TextFieldSuggestionCardTemplate}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DefinitionCard}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <!-- "Reformuler" is specific to Définition (a rephrase of
                         the same meaning, see VocabularyApiClient.
                         TryRephraseDefinitionAsync) — kept outside the shared
                         card template rather than complicating it with a
                         per-type condition also used by Synonymes/Exemples. -->
                    <StackPanel Margin="0,-14,0,20" HorizontalAlignment="Right">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DefinitionCard}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Padding="10,3"
                                FontSize="12"
                                HorizontalAlignment="Right"
                                ToolTip="Régénère une autre formulation de la même définition"
                                Command="{Binding DefinitionCard.RephraseCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DefinitionCard.IsRephrasing}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <!-- Spun forever via its own Loaded trigger; only ever
                                     visible while DefinitionCard.IsRephrasing is true. -->
                                <Path Width="11" Height="11" Stretch="Uniform"
                                      Data="{StaticResource Icon.Phosphor.circle-half-tilt}"
                                      Fill="{DynamicResource Brush.Text.Secondary}"
                                      Margin="0,0,6,0"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </Path.RenderTransform>
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DefinitionCard.IsRephrasing}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                    <Path.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                        From="0" To="360" Duration="0:0:0.8"
                                                        RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Path.Triggers>
                                </Path>
                                <Path Data="{StaticResource Icon.Phosphor.arrow-clockwise}"
                                      Fill="{DynamicResource Brush.Text.Secondary}"
                                      Width="11" Height="11"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0" />
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Reformuler" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DefinitionCard.IsRephrasing}" Value="True">
                                                    <Setter Property="Text" Value="Reformulation..." />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding DefinitionCard.RephraseErrorMessage}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   TextAlignment="Right"
                                   Foreground="{DynamicResource Brush.Danger}"
                                   FontSize="12"
                                   FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DefinitionCard.HasRephraseError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TypeCard}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Type" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1"
                                      Content="Appliquer"
                                      IsChecked="{Binding TypeCard.IsAccepted, Mode=TwoWay}"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding TypeCard.CurrentValueDisplay}"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   FontStyle="Italic">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TypeCard.HasCurrentValue}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ComboBox Margin="0,8,0,0"
                                  ItemsSource="{Binding TypeCard.AvailableTypes}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding TypeCard.SelectedType, Mode=TwoWay}" />

                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding TypeCard.Justification}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.Text.Secondary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TypeCard.HasJustification}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <ContentControl Content="{Binding SynonymsCard}" ContentTemplate="{StaticResource TextFieldSuggestionCardTemplate}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SynonymsCard}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <ContentControl Content="{Binding ExampleSentencesCard}" ContentTemplate="{StaticResource TextFieldSuggestionCardTemplate}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExampleSentencesCard}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="2">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Annuler"
                        Width="96"
                        Margin="0,0,10,0"
                        IsCancel="True" />
                <Button Content="Enregistrer"
                        Width="110"
                        Style="{StaticResource AccentButtonStyle}"
                        IsDefault="True"
                        Command="{Binding SaveCommand}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
