<Window x:Class="LexiCall.Desktop.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LexiCall.Desktop.Windows"
        xmlns:viewModels="clr-namespace:LexiCall.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="LexiCall" Height="760" Width="1260"
        MinHeight="620" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI">
    <!-- Main window: category tree on the left (contextual CRUD), category +
         search filtered list in the center, detail on the right. -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="4,0,4,18">
            <TextBlock Text="LexiCall"
                       FontFamily="{StaticResource Font.Serif}"
                       FontSize="28" />
            <TextBlock Text="Organisation et recherche de vocabulaire par catégorie."
                       Margin="0,2,0,0"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CategoryColumn" Width="320" MinWidth="220" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition x:Name="EntryListColumn" Width="330" MinWidth="240" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Resize handles: real category names can be long, no fixed
                 width fits every case. -->
            <GridSplitter x:Name="CategoryColumnSplitter"
                          Grid.Column="1"
                          Width="12"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext" />
            <GridSplitter Grid.Column="3"
                          Width="12"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext" />

            <!-- ═══ Category panel ═══ -->
            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="6,2,2,8">
                        <DockPanel>
                            <Button x:Name="AddRootCategoryButton"
                                    DockPanel.Dock="Right"
                                    Content="＋"
                                    FontSize="15"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Padding="7,2"
                                    Click="AddRootCategoryButton_Click"
                                    ToolTip="Créer une catégorie." />

                            <TextBlock x:Name="CategoryPanelTitle"
                                       Text="Catégories"
                                       Margin="22,0,0,0"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <ToggleButton x:Name="CategoryPanelToggleButton"
                                      Style="{StaticResource TreeExpanderStyle}"
                                      IsChecked="False"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Click="CategoryPanelToggleButton_Click"
                                      ToolTip="Afficher/masquer les catégories." />
                    </Grid>

                    <ScrollViewer x:Name="CollapsedQuickSelectPanel"
                                  Grid.Row="1"
                                  Visibility="Collapsed"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Hidden">
                        <StackPanel HorizontalAlignment="Center"
                                    Margin="0,0,0,8">
                            <!-- Same active-state language as the expanded tree/list: a neutral
                                 fill plus an accent ring, never color alone — sized as its own
                                 slot (not just the icon) for a comfortable click/hover target. -->
                            <Border Width="32" Height="32"
                                    Margin="0,0,0,4"
                                    CornerRadius="8"
                                    BorderThickness="1.5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding SelectedCategoryNode.Kind}" Value="{x:Static viewModels:CategoryNodeKind.AllEntries}">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Selection.Background}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Button Style="{StaticResource GhostButtonStyle}"
                                        Width="24" Height="24"
                                        Padding="0"
                                        Click="SelectAllEntriesButton_Click"
                                        ToolTip="Toutes les entrées">
                                    <Path Data="{StaticResource Icon.Phosphor.books}"
                                          Fill="{DynamicResource Brush.Icon.Neutral}"
                                          Width="14" Height="14" Stretch="Uniform" />
                                </Button>
                            </Border>
                            <Border Width="32" Height="32"
                                    CornerRadius="8"
                                    BorderThickness="1.5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding SelectedCategoryNode.Kind}" Value="{x:Static viewModels:CategoryNodeKind.Uncategorized}">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Selection.Background}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Button Style="{StaticResource GhostButtonStyle}"
                                        Width="24" Height="24"
                                        Padding="0"
                                        Click="SelectUncategorizedButton_Click"
                                        ToolTip="Sans catégorie">
                                    <Path Data="{StaticResource Icon.Solar.tag}"
                                          Fill="{DynamicResource Brush.Icon.Neutral}"
                                          Width="14" Height="14" Stretch="Uniform" />
                                </Button>
                            </Border>

                            <Separator Margin="2,8,2,8" />

                            <!-- Custom categories: CategoryTree's own top level is exactly the
                                 virtual nodes above plus real ROOT categories (subcategories only
                                 ever live nested under a root's Children, never here directly), so
                                 filtering out IsVirtual is enough to get parent categories only. -->
                            <ItemsControl ItemsSource="{Binding CategoryTree}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVirtual}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:CategoryNodeViewModel}">
                                        <Border Width="32" Height="32"
                                                Margin="0,0,0,4"
                                                CornerRadius="8"
                                                BorderThickness="1.5"
                                                Cursor="Hand"
                                                ToolTip="{Binding DisplayName}"
                                                MouseLeftButtonUp="CollapsedRootCategory_MouseLeftButtonUp">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Selection.Background}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid Width="24" Height="24"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                                <!-- Vector icons resolve through IconKeyToGeometryConverter and
                                                     fill solid with the category's own color, no halo backdrop
                                                     behind them: the icon itself carries the color. A legacy
                                                     emoji (or a virtual node's hardcoded glyph) falls back to
                                                     the TextBlock. -->
                                                <Path Data="{Binding DisplayIcon, Converter={StaticResource IconKeyToGeometryConverter}}"
                                                      Fill="{Binding ColorBrush}"
                                                      Width="14" Height="14" Stretch="Uniform"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DisplayIcon}"
                                                           FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI"
                                                           FontSize="13"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DisplayIcon, Converter={StaticResource IconKeyToGeometryConverter}}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <TreeView Grid.Row="1"
                              x:Name="CategoryTreeView"
                              ItemsSource="{Binding CategoryTree}"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              PreviewKeyDown="CategoryTreeView_KeyDown">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type viewModels:CategoryNodeViewModel}"
                                                      ItemsSource="{Binding Children}">
                                <Grid ToolTip="{Binding DescriptionToolTip}"
                                      ContextMenuOpening="CategoryNode_ContextMenuOpening">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid.ContextMenu>
                                        <!-- FontFamily on each MenuItem: the emoji prefixing the Header
                                             resolves via Segoe UI Emoji/Symbol, the rest of the text falls
                                             back to Segoe UI like everywhere else (per-character resolution). -->
                                        <ContextMenu>
                                            <MenuItem Header="➕  Nouvelle sous-catégorie…"
                                                      FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI"
                                                      Click="AddSubCategoryMenuItem_Click" />
                                            <Separator />
                                            <!-- IsEnabled recomputed on open (CanMoveUp/CanMoveDown), see
                                                 CategoryNode_ContextMenuOpening: disabled at either end of the
                                                 group. Header built by hand (instead of a plain text prefix):
                                                 the thin arrows (↑/↓) stayed thin even in Bold — a solid
                                                 triangle (▲/▼) reads as a much clearer marker, with its own
                                                 size and a fixed-width column aligned with the other icons. -->
                                            <MenuItem IsEnabled="{Binding CanMoveUp}"
                                                      InputGestureText="Ctrl+Haut"
                                                      Click="MoveCategoryUpMenuItem_Click">
                                                <MenuItem.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="▲"
                                                                   FontSize="13"
                                                                   Width="20"
                                                                   TextAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="Monter"
                                                                   Margin="6,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </MenuItem.Header>
                                            </MenuItem>
                                            <MenuItem IsEnabled="{Binding CanMoveDown}"
                                                      InputGestureText="Ctrl+Bas"
                                                      Click="MoveCategoryDownMenuItem_Click">
                                                <MenuItem.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="▼"
                                                                   FontSize="13"
                                                                   Width="20"
                                                                   TextAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="Descendre"
                                                                   Margin="6,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </MenuItem.Header>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem InputGestureText="F2"
                                                      Click="RenameCategoryMenuItem_Click">
                                                <MenuItem.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Grid Width="20">
                                                            <Path Data="{StaticResource Icon.Phosphor.pencil}"
                                                                  Fill="{DynamicResource Brush.Text.Primary}"
                                                                  Width="13" Height="13"
                                                                  Stretch="Uniform"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                        </Grid>
                                                        <TextBlock Text="Renommer"
                                                                   Margin="6,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </MenuItem.Header>
                                            </MenuItem>
                                            <MenuItem Click="EditCategoryMenuItem_Click">
                                                <MenuItem.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Grid Width="20">
                                                            <Path Data="{StaticResource Icon.Phosphor.gear}"
                                                                  Fill="{DynamicResource Brush.Text.Primary}"
                                                                  Width="13" Height="13"
                                                                  Stretch="Uniform"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                        </Grid>
                                                        <TextBlock Text="Modifier…"
                                                                   Margin="6,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </MenuItem.Header>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Click="DeleteCategoryMenuItem_Click">
                                                <MenuItem.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE74D;"
                                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                   FontSize="13"
                                                                   Width="20"
                                                                   TextAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="Supprimer"
                                                                   Margin="6,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </MenuItem.Header>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Grid.ContextMenu>

                                    <!-- Separates the two virtual nodes (Toutes les entrées /
                                         Sans catégorie) from the real categories below. -->
                                    <Border Grid.Column="0" Grid.ColumnSpan="3"
                                            BorderThickness="0,0,0,1"
                                            BorderBrush="{DynamicResource Brush.Border.Strong}"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,-10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static viewModels:CategoryNodeKind.Uncategorized}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <!-- Leading marker: color stays confined to this one small area,
                                         never a full-row band. Root categories (and the two virtual
                                         nodes) get a colored icon: the vector fills solid with
                                         ColorBrush, no halo backdrop needed. Sub-categories get a
                                         small dot instead. -->
                                    <Grid Grid.Column="0"
                                          Width="24" Height="24"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Background="Transparent">
                                        <!-- Vector icons resolve through IconKeyToGeometryConverter;
                                             a legacy emoji falls back to the TextBlock. The outer
                                             Grid keeps the existing Depth==0 gating; Path/TextBlock
                                             toggle between themselves based on icon resolution. -->
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Depth}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <!-- Virtual nodes' Fill is overridden to the same live
                                                 DynamicResource the collapsed rail buttons use, instead
                                                 of ColorBrush (a SolidColorBrush snapshot taken once at
                                                 tree-build time, which would otherwise go stale relative
                                                 to the rail after a theme toggle without a rebuild). -->
                                            <Path Data="{Binding DisplayIcon, Converter={StaticResource IconKeyToGeometryConverter}}"
                                                  Width="14" Height="14" Stretch="Uniform">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="{Binding ColorBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsVirtual}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.Icon.Neutral}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock Text="{Binding DisplayIcon}"
                                                       FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI"
                                                       FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DisplayIcon, Converter={StaticResource IconKeyToGeometryConverter}}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <Ellipse Width="8" Height="8"
                                                 Fill="{Binding ColorBrush}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Depth}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>

                                    <Grid Grid.Column="1" Margin="6,0,0,0">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <TextBlock Text="{Binding DisplayName}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Margin" Value="0,1,0,1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Depth}" Value="0">
                                                            <Setter Property="Margin" Value="0,3,0,3" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsSelected}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Inline rename: Enter commits, Escape cancels. -->
                                    <TextBox Grid.Column="1"
                                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="4,1"
                                             Margin="2,-2,4,-2"
                                             IsVisibleChanged="RenameTextBox_IsVisibleChanged"
                                             KeyDown="RenameTextBox_KeyDown"
                                             LostFocus="RenameTextBox_LostFocus">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>

                                    <Border Grid.Column="2"
                                            Background="{DynamicResource Brush.Chip.Neutral.Background}"
                                            CornerRadius="9"
                                            Padding="7,1"
                                            VerticalAlignment="Top">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Margin" Value="6,1,2,1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Depth}" Value="0">
                                                        <Setter Property="Margin" Value="6,3,2,3" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding EntryCount}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Brush.Chip.Neutral.Foreground}" />
                                    </Border>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Separator Grid.Row="0"
                                   Background="{DynamicResource Brush.Border.Strong}"
                                   Margin="4,14,4,14" />

                        <!-- Collapsed (rail): centered 32px icon tiles, the exact
                             same recipe as CollapsedQuickSelectPanel above. -->
                        <StackPanel x:Name="FooterCollapsedPanel"
                                    Grid.Row="1"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,4">
                            <Border Width="32" Height="32"
                                    Margin="0,0,0,4"
                                    CornerRadius="8"
                                    Cursor="Hand"
                                    ToolTip="{Binding LastSyncedAtTooltip}"
                                    MouseLeftButtonUp="SyncStatusRow_MouseLeftButtonUp">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GlobalSyncStatus}" Value="{x:Static viewModels:GlobalSyncStatus.NotConfigured}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Ellipse Width="13" Height="13"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GlobalSyncStatus}" Value="{x:Static viewModels:GlobalSyncStatus.Ok}">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding GlobalSyncStatus}" Value="{x:Static viewModels:GlobalSyncStatus.Syncing}">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Border>

                            <Border Width="32" Height="32"
                                    CornerRadius="8"
                                    Cursor="Hand"
                                    ToolTip="Options"
                                    MouseLeftButtonUp="OptionsRow_MouseLeftButtonUp">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Path Data="{StaticResource Icon.Phosphor.gear}"
                                      Fill="{DynamicResource Brush.Text.Secondary}"
                                      Width="15" Height="15" Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- Expanded: same icon-column(24) + label(margin 6)
                             rhythm as a category tree row. -->
                        <StackPanel x:Name="FooterExpandedPanel"
                                    Grid.Row="1"
                                    Margin="6,0,2,2">
                            <Border CornerRadius="6"
                                    Padding="0,5"
                                    Margin="0,0,0,12"
                                    Cursor="Hand"
                                    ToolTip="{Binding LastSyncedAtTooltip}"
                                    MouseLeftButtonUp="SyncStatusRow_MouseLeftButtonUp">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GlobalSyncStatus}" Value="{x:Static viewModels:GlobalSyncStatus.NotConfigured}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0"
                                             Width="13" Height="13"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GlobalSyncStatus}" Value="{x:Static viewModels:GlobalSyncStatus.Ok}">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding GlobalSyncStatus}" Value="{x:Static viewModels:GlobalSyncStatus.Syncing}">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <TextBlock Grid.Column="1"
                                               Margin="6,0,0,0"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Text.Secondary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Erreur de synchronisation" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GlobalSyncStatus}" Value="{x:Static viewModels:GlobalSyncStatus.Ok}">
                                                        <Setter Property="Text" Value="Connecté" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding GlobalSyncStatus}" Value="{x:Static viewModels:GlobalSyncStatus.Syncing}">
                                                        <Setter Property="Text" Value="Synchronisation…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <Border CornerRadius="6"
                                    Padding="0,5"
                                    Cursor="Hand"
                                    ToolTip="Options"
                                    MouseLeftButtonUp="OptionsRow_MouseLeftButtonUp">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0"
                                          Data="{StaticResource Icon.Phosphor.gear}"
                                          Fill="{DynamicResource Brush.Text.Secondary}"
                                          Width="15" Height="15" Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="Paramètres"
                                               Margin="6,0,0,0"
                                               FontSize="14"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ═══ Search and entry list ═══ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBox x:Name="SearchTextBox"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Recherche dans les mots, définitions, notes, exemples, catégories et tags.">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Padding" Value="9,6,40,6" />
                                <Style.Triggers>
                                    <!-- Space reserved for the magnifier only at rest (empty, unfocused):
                                         as soon as it's clicked, text starts flush with the edge. -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding SearchQuery}" Value="" />
                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsKeyboardFocusWithin}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Padding" Value="36,6,40,6" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Placeholder-style magnifier: decorative
                         (IsHitTestVisible=False), visible only at rest
                         (empty, unfocused). -->
                    <Canvas Width="14" Height="14"
                            Margin="15,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Opacity="0.55"
                            IsHitTestVisible="False">
                        <Canvas.Style>
                            <Style TargetType="Canvas">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding SearchQuery}" Value="" />
                                            <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchTextBox}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Canvas.Style>
                        <Ellipse Canvas.Left="0" Canvas.Top="0"
                                 Width="9" Height="9"
                                 Stroke="{DynamicResource Brush.Text.Secondary}"
                                 StrokeThickness="1.4" />
                        <Line X1="8" Y1="8" X2="13" Y2="13"
                              Stroke="{DynamicResource Brush.Text.Secondary}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Canvas>

                    <!-- Placeholder text: same rest-only condition as the magnifier above,
                         so both appear and disappear together. -->
                    <TextBlock Text="Rechercher un mot..."
                               Margin="36,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding SearchQuery}" Value="" />
                                            <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchTextBox}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Clear cross: visible only while the search isn't empty. -->
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="18" Height="18"
                            Margin="0,0,15,0"
                            Padding="0"
                            Focusable="False"
                            Click="ClearSearchButton_Click"
                            ToolTip="Effacer la recherche">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Canvas Width="8" Height="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Line X1="0" Y1="0" X2="8" Y2="8"
                                  Stroke="{DynamicResource Brush.Text.Secondary}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                            <Line X1="8" Y1="0" X2="0" Y2="8"
                                  Stroke="{DynamicResource Brush.Text.Secondary}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Canvas>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="4,8,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{Binding SelectedCategoryLabel}"
                               ToolTip="{Binding SelectedCategoryTooltip}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="{Binding SearchStatusText}"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               FontSize="12" />
                    <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                            Content="＋"
                            FontSize="18"
                            FontWeight="Bold"
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="0"
                            Width="32"
                            Height="32"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"
                            Click="AddEntryButton_Click"
                            ToolTip="Ajouter un mot." />
                </Grid>

                <Border Grid.Row="2"
                        Style="{StaticResource CardBorderStyle}"
                        Padding="6">
                    <Grid>
                        <ListBox ItemsSource="{Binding FilteredEntries}"
                                 SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource CardListBoxItemStyle}"
                                 Padding="0,0,8,0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Word}"
                                                   FontFamily="{StaticResource Font.Serif}"
                                                   FontSize="20" />

                                        <ItemsControl Margin="0,4,0,0">
                                            <ItemsControl.ItemsSource>
                                                <MultiBinding Converter="{StaticResource CategoryNamesConverter}">
                                                    <Binding Path="CategoryIds" />
                                                    <Binding Path="DataContext.Categories"
                                                             RelativeSource="{RelativeSource AncestorType=Window}" />
                                                </MultiBinding>
                                            </ItemsControl.ItemsSource>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>

                                                    <Border CornerRadius="6"
                                                            Padding="4,2"
                                                            Margin="0,0,8,0"
                                                            BorderThickness="1.5"
                                                            Cursor="Hand"
                                                            ToolTip="Filtrer par cette catégorie"
                                                            MouseLeftButtonUp="CategoryChip_MouseLeftButtonUp">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource Brush.Selection.Background}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="8" Height="8"
                                                                     VerticalAlignment="Center"
                                                                     Margin="0,0,5,0">
                                                                <Ellipse.RenderTransform>
                                                                    <TranslateTransform Y="1" />
                                                                </Ellipse.RenderTransform>
                                                                <Ellipse.Fill>
                                                                    <MultiBinding Converter="{StaticResource CategoryDotColorConverter}">
                                                                        <Binding Path="." />
                                                                        <Binding Path="DataContext.Categories"
                                                                                 RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                    </MultiBinding>
                                                                </Ellipse.Fill>
                                                            </Ellipse>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="{Binding EmptyListMessage}"
                                   Width="240"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFilteredEntries}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ Selected entry's detail ═══ -->
            <Border Grid.Column="4"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="26">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="Détails"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   FontWeight="SemiBold" />

                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Margin="0,0,10,0"
                                    Click="EditEntryButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedEntry}" Value="{x:Null}">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Phosphor.pencil}"
                                          Fill="{DynamicResource Brush.Text.Secondary}"
                                          Width="13" Height="13"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0" />
                                    <TextBlock Text="Modifier" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Click="DeleteEntryButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedEntry}" Value="{x:Null}">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <TextBlock Text="Supprimer" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  FocusVisualStyle="{x:Null}">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedEntry}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <ContentControl Content="{Binding SelectedEntry}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Word}"
                                                   FontFamily="{StaticResource Font.Serif}"
                                                   FontSize="34" />
                                        <TextBlock Text="{Binding Definition}"
                                                   FontFamily="{StaticResource Font.Serif}"
                                                   FontWeight="Normal"
                                                   Margin="0,20,0,0"
                                                   FontSize="16"
                                                   TextWrapping="Wrap" />

                                        <!-- Categories come first: that's the main organizing axis.
                                             A small color dot, not a filled badge — color stays a
                                             discreet accent, consistent with the entry list. -->
                                        <ItemsControl ItemsSource="{Binding DataContext.SelectedEntryCategories, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      Margin="0,30,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- Clickable: selects this category in the left-hand
                                                         panel (Cursor="Hand" signals the action). Same
                                                         accent-ring hover recipe as the entry list's chips
                                                         above (Selection.Background + Accent border, not
                                                         Surface.Hover). -->
                                                    <Border CornerRadius="6"
                                                            Padding="4,2"
                                                            Margin="0,0,12,2"
                                                            BorderThickness="1.5"
                                                            Cursor="Hand"
                                                            ToolTip="Filtrer par cette catégorie"
                                                            MouseLeftButtonUp="CategoryChip_MouseLeftButtonUp">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource Brush.Selection.Background}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="9" Height="9"
                                                                     VerticalAlignment="Center"
                                                                     Margin="0,0,6,0">
                                                                <Ellipse.Fill>
                                                                    <MultiBinding Converter="{StaticResource CategoryDotColorConverter}">
                                                                        <Binding Path="." />
                                                                        <Binding Path="DataContext.Categories"
                                                                                 RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                    </MultiBinding>
                                                                </Ellipse.Fill>
                                                            </Ellipse>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="13"
                                                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Separator Margin="0,16,0,20" />

                                        <!-- Metadata sections on the left, the image as its own section
                                             (same icon+label+separator header as the others, so it reads
                                             as part of the same structure, not a floating picture) on the
                                             right — Auto column, collapses to 0 when absent. Below
                                             WidthBreakpointConverter's threshold, Style.Triggers move it to
                                             a full-width 2nd row — Grid.Row/Column must therefore stay set
                                             via Style, not as a direct attribute, or the local value would
                                             win over the Trigger. -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0"
                                                        Grid.Column="0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Grid.ColumnSpan" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource WidthBreakpointConverter}}"
                                                                         Value="True">
                                                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <!-- Each metadata section is a header row (icon, label)
                                                     over a thin separator, then its content indented to
                                                     align under the label. -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Path Grid.Column="0"
                                                          Data="{StaticResource Icon.Phosphor.book-open}"
                                                          Fill="{DynamicResource Brush.Text.Secondary}"
                                                          Width="14" Height="14" Stretch="Uniform"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,10,0" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="Synonymes"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <Separator Margin="0,10,0,14" />
                                                <ItemsControl ItemsSource="{Binding Synonyms}"
                                                              Margin="15,0,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,8,8"
                                                                    Padding="9,4"
                                                                    Background="{DynamicResource Brush.Chip.Synonym.Background}"
                                                                    CornerRadius="12">
                                                                <TextBlock Text="{Binding}"
                                                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Grid Margin="0,20,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Path Grid.Column="0"
                                                          Data="{StaticResource Icon.Phosphor.quotes}"
                                                          Fill="{DynamicResource Brush.Text.Secondary}"
                                                          Width="14" Height="14" Stretch="Uniform"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,10,0" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="Exemples"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <Separator Margin="0,10,0,14" />
                                                <ItemsControl ItemsSource="{Binding ExampleSentences}"
                                                              Margin="24,0,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}"
                                                                       Margin="0,0,0,8"
                                                                       FontStyle="Italic"
                                                                       TextWrapping="Wrap" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Grid Margin="0,20,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Path Grid.Column="0"
                                                          Data="{StaticResource Icon.Phosphor.note-pencil}"
                                                          Fill="{DynamicResource Brush.Text.Secondary}"
                                                          Width="14" Height="14" Stretch="Uniform"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,10,0" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="Notes personnelles"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <Separator Margin="0,10,0,14" />
                                                <TextBlock Text="{Binding Notes}"
                                                           Margin="24,0,0,0"
                                                           TextWrapping="Wrap" />

                                                <Grid Margin="0,20,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Path Grid.Column="0"
                                                          Data="{StaticResource Icon.Solar.document}"
                                                          Fill="{DynamicResource Brush.Text.Secondary}"
                                                          Width="14" Height="14" Stretch="Uniform"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,10,0" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="Source"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <Separator Margin="0,10,0,14" />
                                                <TextBlock Text="{Binding Source}"
                                                           Margin="24,0,0,0"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                                            </StackPanel>

                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Grid.Row" Value="0" />
                                                        <Setter Property="Grid.Column" Value="1" />
                                                        <Setter Property="Grid.ColumnSpan" Value="1" />
                                                        <Setter Property="Margin" Value="20,0,0,0" />
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ImageBase64}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource WidthBreakpointConverter}}"
                                                                         Value="True">
                                                                <Setter Property="Grid.Row" Value="1" />
                                                                <Setter Property="Grid.Column" Value="0" />
                                                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                                                <Setter Property="Margin" Value="0,20,0,0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Path Grid.Column="0"
                                                          Data="{StaticResource Icon.Phosphor.image}"
                                                          Fill="{DynamicResource Brush.Text.Secondary}"
                                                          Width="14" Height="14" Stretch="Uniform"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,10,0" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="Image"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <Separator Margin="0,10,0,14" />

                                                <Border x:Name="DetailImageFrame"
                                                        MaxWidth="220"
                                                        MaxHeight="220"
                                                        HorizontalAlignment="Left"
                                                        Background="{DynamicResource Brush.Surface.Hover}"
                                                        CornerRadius="8"
                                                        Cursor="Hand"
                                                        Margin="24,0,0,0"
                                                        MouseLeftButtonUp="DetailImage_MouseLeftButtonUp">
                                                    <!-- CornerRadius alone only rounds the Border's own
                                                         Background/BorderBrush painting — a child Image still
                                                         clips to a plain rectangle unless the Border's own Clip
                                                         is set to a matching rounded geometry. ElementName (not
                                                         RelativeSource=Self): Geometry isn't a FrameworkElement,
                                                         so it has no "self" to resolve against. -->
                                                    <Border.Clip>
                                                        <RectangleGeometry RadiusX="8" RadiusY="8">
                                                            <RectangleGeometry.Rect>
                                                                <MultiBinding Converter="{StaticResource SizeToRectConverter}">
                                                                    <Binding ElementName="DetailImageFrame" Path="ActualWidth" />
                                                                    <Binding ElementName="DetailImageFrame" Path="ActualHeight" />
                                                                </MultiBinding>
                                                            </RectangleGeometry.Rect>
                                                        </RectangleGeometry>
                                                    </Border.Clip>

                                                    <Image Source="{Binding ImageBase64, Converter={StaticResource Base64ImageConverter}}"
                                                           MaxWidth="220"
                                                           MaxHeight="220"
                                                           Stretch="Uniform" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="1"
                               Text="{Binding EmptyDetailMessage}"
                               Width="360"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedEntry}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Sync status for the selected entry -->
            <StackPanel Grid.Row="1"
                        Grid.Column="4"
                        Orientation="Horizontal"
                        Margin="4,8,4,0"
                        HorizontalAlignment="Right">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedEntrySyncStatusText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Ellipse Width="8"
                         Height="8"
                         VerticalAlignment="Center"
                         Margin="0,0,6,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource Brush.Chip.Neutral.Foreground}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedEntrySyncIsSynced}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <TextBlock Text="{Binding SelectedEntrySyncStatusText}"
                           FontSize="12"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

    </Grid>
</Window>
