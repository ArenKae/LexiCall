<Window x:Class="LexiCall.Desktop.CategoryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="520" Width="520"
        MinHeight="500" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI">
    <!-- Modal add/edit category form (quick rename happens directly in the
         main window's tree instead). -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding HeaderText}"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding DescriptionText}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,18"
                Padding="20"
                Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Nom *"
                           FontWeight="SemiBold" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center" />

                    <!-- Icon picker: opens IconPickerWindow, which closes
                         itself as soon as an icon is chosen. -->
                    <!-- Vector icons resolve through IconKeyToGeometryConverter; a legacy
                         emoji (or the default "no icon" tag) falls back to the TextBlock,
                         since the converter returns null for anything it can't resolve. -->
                    <Button Grid.Column="1"
                            Width="44" Height="36"
                            Padding="0"
                            Margin="8,0,0,0"
                            Click="ChooseIconButton_Click"
                            ToolTip="Choisir une icône pour cette catégorie.">
                        <Grid>
                            <Path Data="{Binding IconDisplayGlyph, Converter={StaticResource IconKeyToGeometryConverter}}"
                                  Fill="{DynamicResource Brush.Text.Primary}"
                                  Width="18" Height="18" Stretch="Uniform" />
                            <TextBlock Text="{Binding IconDisplayGlyph}"
                                       FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI"
                                       FontSize="18">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IconDisplayGlyph, Converter={StaticResource IconKeyToGeometryConverter}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Button>

                    <Button Grid.Column="2"
                            Width="28" Height="36"
                            Padding="0"
                            Margin="4,0,0,0"
                            Click="ClearIconButton_Click"
                            ToolTip="Retirer l'icône">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="✕" FontSize="10" />
                    </Button>
                </Grid>

                <TextBlock Text="Couleur"
                           Margin="0,14,0,0"
                           FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal"
                            Margin="0,6,0,0">
                    <!-- Color picker: opens ColorPickerWindow, which closes
                         itself as soon as a color (or "Automatique") is chosen. -->
                    <Button Width="36" Height="36"
                            Padding="0"
                            Click="ChooseColorButton_Click"
                            ToolTip="Choisir une couleur pour cette catégorie.">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="18"
                                        Background="{Binding ColorPreviewBrush}"
                                        BorderThickness="2"
                                        BorderBrush="{DynamicResource Brush.Border.Strong}" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Text="Automatique"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text.Secondary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCustomColor}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Margin="10,0,0,0"
                            Padding="10,0"
                            Height="36"
                            Click="ClearColorButton_Click"
                            ToolTip="Revenir à la couleur automatique">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCustomColor}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Automatique" FontSize="12" />
                    </Button>
                </StackPanel>

                <TextBlock Text="Catégorie parente"
                           Margin="0,14,0,0"
                           FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding ParentOptions}"
                          SelectedItem="{Binding SelectedParentOption, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          Margin="0,6,0,0" />

                <TextBlock Text="Description"
                           Margin="0,14,0,0"
                           FontWeight="SemiBold" />
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,6,0,0"
                         Height="72"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" />

                <TextBlock Text="{Binding ErrorMessage}"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Danger}"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Annuler"
                    Width="96"
                    Margin="0,0,10,0"
                    IsCancel="True" />
            <Button Content="{Binding SaveButtonText}"
                    Width="110"
                    Style="{StaticResource AccentButtonStyle}"
                    IsDefault="True"
                    Command="{Binding SaveCategoryCommand}" />
        </StackPanel>
    </Grid>
</Window>
