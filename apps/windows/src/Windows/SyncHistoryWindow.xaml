<Window x:Class="LexiCall.Desktop.Windows.SyncHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:LexiCall.Desktop.Models"
        Title="Historique de synchronisation"
        Width="480" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">
    <!-- Sync history modal (opened from the footer's connection indicator):
         recaps recent push/pull/delete operations per entry/category. Binds
         directly to MainWindowViewModel.SyncHistory, so a live operation
         (e.g. from the periodic resync) appears while this window is open. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Historique de synchronisation"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <TextBlock Grid.Row="1"
                   Text="Aucune opération de synchronisation enregistrée pour le moment."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Text.Secondary}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SyncHistory.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ScrollViewer Grid.Row="1"
                      Padding="0,0,12,0"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SyncHistory}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Icon shape encodes the operation (push/pull/delete),
                                 its color encodes the outcome — same Success/Danger
                                 brushes as the footer's connection dot. -->
                            <Path Grid.Column="0"
                                  Width="16" Height="16"
                                  Margin="0,0,10,0"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource Icon.Phosphor.caret-circle-up}" />
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Operation}" Value="{x:Static models:SyncHistoryOperation.Pull}">
                                                <Setter Property="Data" Value="{StaticResource Icon.Phosphor.caret-circle-down}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Operation}" Value="{x:Static models:SyncHistoryOperation.Delete}">
                                                <Setter Property="Data" Value="{StaticResource Icon.Phosphor.trash}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Outcome}" Value="{x:Static models:SyncHistoryOutcome.Success}">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding EntityLabel}"
                                           FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource Brush.Text.Secondary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding EntityType}" Value="{x:Static models:SyncHistoryEntityType.Entry}" />
                                                            <Condition Binding="{Binding Operation}" Value="{x:Static models:SyncHistoryOperation.Push}" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Text" Value="Mot — envoi" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding EntityType}" Value="{x:Static models:SyncHistoryEntityType.Entry}" />
                                                            <Condition Binding="{Binding Operation}" Value="{x:Static models:SyncHistoryOperation.Pull}" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Text" Value="Mot — réception" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding EntityType}" Value="{x:Static models:SyncHistoryEntityType.Entry}" />
                                                            <Condition Binding="{Binding Operation}" Value="{x:Static models:SyncHistoryOperation.Delete}" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Text" Value="Mot — suppression" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding EntityType}" Value="{x:Static models:SyncHistoryEntityType.Category}" />
                                                            <Condition Binding="{Binding Operation}" Value="{x:Static models:SyncHistoryOperation.Push}" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Text" Value="Catégorie — envoi" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding EntityType}" Value="{x:Static models:SyncHistoryEntityType.Category}" />
                                                            <Condition Binding="{Binding Operation}" Value="{x:Static models:SyncHistoryOperation.Pull}" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Text" Value="Catégorie — réception" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding EntityType}" Value="{x:Static models:SyncHistoryEntityType.Category}" />
                                                            <Condition Binding="{Binding Operation}" Value="{x:Static models:SyncHistoryOperation.Delete}" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Text" Value="Catégorie — suppression" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Redundant with the icon's color, on purpose:
                                         a color-only failure signal is easy to miss
                                         at a glance in a dense list. -->
                                    <TextBlock Text=" · Échec"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Danger}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Outcome}" Value="{x:Static models:SyncHistoryOutcome.Failure}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding Timestamp, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}"
                                       FontSize="12"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text.Muted}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Vider l'historique"
                    Style="{StaticResource GhostButtonStyle}"
                    FontSize="12"
                    Padding="6,3"
                    Foreground="{DynamicResource Brush.Text.Muted}"
                    Click="ClearHistoryButton_Click" />
        </StackPanel>
    </Grid>
</Window>
