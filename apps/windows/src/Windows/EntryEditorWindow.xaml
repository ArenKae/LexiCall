<Window x:Class="LexiCall.Desktop.Windows.EntryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="860" Width="820"
        MinHeight="620" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI"
        Loaded="EntryEditorWindow_Loaded">
    <Window.Resources>
        <!-- Enrich button -->
        <Style x:Key="EnrichButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- Entry editor form -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding HeaderText}"
                       FontSize="26"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding DescriptionText}"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,20,0,20"
                Padding="20,20,8,20"
                Style="{StaticResource CardBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Padding="0,0,24,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- ═══ Left column: text fields ═══ -->
                        <StackPanel Grid.Column="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="{StaticResource Icon.Phosphor.book-bookmark}"
                                      Fill="{DynamicResource Brush.Text.Secondary}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Mot *" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="2"
                                        ToolTip="Suggérer une définition et plus avec l'IA"
                                        Command="{Binding EnrichDraftCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource EnrichButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanEnrichDraft}" Value="False">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="13" Height="13" Stretch="Uniform"
                                              Data="{StaticResource Icon.Phosphor.circle-half-tilt}"
                                              Fill="{DynamicResource Brush.Accent}"
                                              Margin="0,0,7,0"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </Path.RenderTransform>
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnrichingDraft}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                            <Path.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                From="0" To="360" Duration="0:0:0.8"
                                                                RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Path.Triggers>
                                        </Path>
                                        <Path Data="{StaticResource Icon.Phosphor.sparkle}"
                                              Width="13" Height="13"
                                              Stretch="Uniform"
                                              VerticalAlignment="Center"
                                              Margin="0,0,7,0">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnrichingDraft}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock Text="Enrichir" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBox Margin="0,8,0,12"
                                     Text="{Binding Word, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="{Binding EnrichmentErrorMessage}"
                                       Margin="0,0,0,12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.Danger}"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasEnrichmentError}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="{StaticResource Icon.Solar.notebook}"
                                      Fill="{DynamicResource Brush.Text.Secondary}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Définition *" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ToggleButton Grid.Column="2"
                                              Style="{StaticResource FieldLockToggleStyle}"
                                              IsChecked="{Binding IsDefinitionLocked, Mode=TwoWay}" />
                            </Grid>
                            <!-- One TextBox per sense: a definition is a list,
                                 and the form mirrors that shape. -->
                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding DefinitionSenses.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="False"
                                                     VerticalContentAlignment="Top"
                                                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="1"
                                                    Content="✕"
                                                    Width="22" Height="22"
                                                    Padding="0"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Top"
                                                    ToolTip="Retirer ce sens"
                                                    Command="{Binding RemoveCommand}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanRemove}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button HorizontalAlignment="Left"
                                    Margin="0,2,0,20"
                                    Command="{Binding DefinitionSenses.AddSenseCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Phosphor.plus}"
                                          Fill="{DynamicResource Brush.Text.Secondary}"
                                          Width="11" Height="11"
                                          Stretch="Uniform"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0" />
                                    <TextBlock Text="Ajouter un sens" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="{StaticResource Icon.Phosphor.book-open}"
                                      Fill="{DynamicResource Brush.Text.Secondary}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Synonymes" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ToggleButton Grid.Column="2"
                                              Style="{StaticResource FieldLockToggleStyle}"
                                              IsChecked="{Binding IsSynonymsLocked, Mode=TwoWay}" />
                            </Grid>
                            <TextBox Margin="0,8,0,20"
                                     Text="{Binding SynonymsText, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="{StaticResource Icon.Phosphor.quotes}"
                                      Fill="{DynamicResource Brush.Text.Secondary}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Exemples" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ToggleButton Grid.Column="2"
                                              Style="{StaticResource FieldLockToggleStyle}"
                                              IsChecked="{Binding IsExampleSentencesLocked, Mode=TwoWay}" />
                            </Grid>
                            <TextBox Margin="0,8,0,20"
                                     Height="96"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     Text="{Binding ExampleSentencesText, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="{StaticResource Icon.Phosphor.note-pencil}"
                                      Fill="{DynamicResource Brush.Text.Secondary}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Notes personnelles" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                            <TextBox Margin="0,8,0,0"
                                     Height="90"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- ═══ Right column: metadata ═══ -->
                        <StackPanel Grid.Column="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="{StaticResource Icon.Solar.tag}"
                                      Fill="{DynamicResource Brush.Text.Secondary}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Catégories" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="2"
                                        ToolTip="Suggérer une catégorie avec l'IA"
                                        Command="{Binding CategorizeDraftCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource EnrichButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanCategorizeDraft}" Value="False">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="13" Height="13" Stretch="Uniform"
                                              Data="{StaticResource Icon.Phosphor.circle-half-tilt}"
                                              Fill="{DynamicResource Brush.Accent}"
                                              Margin="0,0,7,0"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </Path.RenderTransform>
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCategorizingDraft}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                            <Path.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                From="0" To="360" Duration="0:0:0.8"
                                                                RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Path.Triggers>
                                        </Path>
                                        <Path Data="{StaticResource Icon.Phosphor.sparkle}"
                                              Width="13" Height="13"
                                              Stretch="Uniform"
                                              VerticalAlignment="Center"
                                              Margin="0,0,7,0">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCategorizingDraft}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock Text="Catégoriser" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBlock Text="{Binding CategorizationErrorMessage}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.Danger}"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCategorizationError}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Grid Margin="0,8,0,20">
                                <Border BorderBrush="{DynamicResource Brush.Border.Strong}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Background="{DynamicResource Brush.Input.Background}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAvailableCategories}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ListBox x:Name="CategoryList"
                                             ItemsSource="{Binding CategorySelections}"
                                             Height="330"
                                             Padding="8"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                <Setter Property="Padding" Value="2,1" />
                                                <Setter Property="Margin" Value="0" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4"
                                                        Padding="4,2"
                                                        BorderThickness="3,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="BorderBrush" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.Selection.Background}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <CheckBox Content="{Binding Name}"
                                                              Margin="{Binding Depth, Converter={StaticResource DepthToIndentConverter}}"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>

                                <TextBlock Text="Aucune catégorie disponible. Tu peux en créer depuis le panneau latéral de la fenêtre principale."
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAvailableCategories}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="{StaticResource Icon.Phosphor.shapes}"
                                      Fill="{DynamicResource Brush.Text.Secondary}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Type *" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ToggleButton Grid.Column="2"
                                              Style="{StaticResource FieldLockToggleStyle}"
                                              IsChecked="{Binding IsTypeLocked, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,8,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding AvailableTypes}"
                                          DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedTypeOption, Mode=TwoWay}" />
                                <CheckBox Grid.Column="1"
                                          Content="Archivé"
                                          Margin="12,0,0,0"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsArchived}" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="{StaticResource Icon.Solar.document}"
                                      Fill="{DynamicResource Brush.Text.Secondary}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Source" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                            <TextBox Margin="0,8,0,20"
                                     Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <!-- ═══ Images ═══ -->
                    <Separator Margin="0,4,0,16" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0"
                              Data="{StaticResource Icon.Phosphor.image}"
                              Fill="{DynamicResource Brush.Text.Secondary}"
                              Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="Images (4 maximum)" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding Images}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,14,10" Width="128">
                                        <Grid>
                                            <Border x:Name="ImageThumbnailFrame"
                                                    Width="128"
                                                    Height="104"
                                                    BorderBrush="{DynamicResource Brush.Border.Strong}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Background="{DynamicResource Brush.Input.Background}">
                                                <Border.Clip>
                                                    <RectangleGeometry RadiusX="6" RadiusY="6">
                                                        <RectangleGeometry.Rect>
                                                            <MultiBinding Converter="{StaticResource SizeToRectConverter}">
                                                                <Binding ElementName="ImageThumbnailFrame" Path="ActualWidth" />
                                                                <Binding ElementName="ImageThumbnailFrame" Path="ActualHeight" />
                                                            </MultiBinding>
                                                        </RectangleGeometry.Rect>
                                                    </RectangleGeometry>
                                                </Border.Clip>
                                                <Image Source="{Binding ImageBase64, Converter={StaticResource Base64ImageConverter}}"
                                                       Stretch="Uniform" />
                                            </Border>
                                            <Button Content="✕"
                                                    Width="22" Height="22"
                                                    Padding="0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="0,-8,-8,0"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    ToolTip="Retirer cette image"
                                                    Command="{Binding RemoveCommand}" />
                                        </Grid>
                                        <TextBox Margin="0,6,0,0"
                                                 MinHeight="40"
                                                 MaxHeight="76"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Top"
                                                 Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Légende de l'image" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Ajouter des images..."
                                Width="150"
                                HorizontalAlignment="Left"
                                Margin="0,4,0,0"
                                Click="AddImagesButton_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanAddMoreImages}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Margin="0,14,0,0"
                               Foreground="{DynamicResource Brush.Danger}"
                               FontWeight="SemiBold" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="2">
            <TextBlock Text="Les champs marqués d'un * sont requis."
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Annuler"
                        Width="96"
                        Margin="0,0,10,0"
                        IsCancel="True" />
                <Button Content="{Binding SaveButtonText}"
                        Width="110"
                        Style="{StaticResource AccentButtonStyle}"
                        IsDefault="True"
                        Command="{Binding SaveEntryCommand}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
