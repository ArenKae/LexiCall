<Window x:Class="LexiCall.Desktop.Windows.EntryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="700" Width="760"
        MinHeight="620" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI">
    <!--
        Modal add/edit entry form. Categories are optional and picked via
        checkboxes, indented by their depth in the hierarchy.
    -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding HeaderText}"
                       FontSize="26"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding DescriptionText}"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,20,0,20"
                Padding="20,20,8,20"
                Style="{StaticResource CardBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Padding="0,0,24,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Mot *"
                               FontWeight="SemiBold" />
                    <TextBox Grid.Row="1"
                             Grid.Column="0"
                             Margin="0,6,0,14"
                             Text="{Binding Word, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Définition *"
                               FontWeight="SemiBold" />
                    <TextBox Grid.Row="3"
                             Grid.Column="0"
                             Margin="0,6,0,14"
                             Height="84"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Text="{Binding Definition, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Text="Catégories"
                               FontWeight="SemiBold" />
                    <Grid Grid.Row="1"
                          Grid.RowSpan="3"
                          Grid.Column="2"
                          Margin="0,6,0,14"
                          VerticalAlignment="Top">
                        <Border BorderBrush="{DynamicResource Brush.Border.Strong}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Background="{DynamicResource Brush.Input.Background}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAvailableCategories}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ListBox ItemsSource="{Binding CategorySelections}"
                                     Height="200"
                                     Padding="8"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Padding" Value="4,3" />
                                        <Setter Property="Margin" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}"
                                                  Margin="{Binding Depth, Converter={StaticResource DepthToIndentConverter}}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <TextBlock Text="Aucune catégorie disponible. Tu peux en créer depuis le panneau latéral de la fenêtre principale."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAvailableCategories}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               Text="Type"
                               FontWeight="SemiBold" />
                    <ComboBox Grid.Row="5"
                              Grid.Column="0"
                              Margin="0,6,0,14"
                              ItemsSource="{Binding AvailableTypes}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Type}" />

                    <CheckBox Grid.Row="5"
                              Grid.Column="2"
                              Content="Archivé"
                              VerticalAlignment="Center"
                              Margin="0,6,0,14"
                              IsChecked="{Binding IsArchived}" />

                    <TextBlock Grid.Row="6"
                               Grid.Column="0"
                               Text="Source"
                               FontWeight="SemiBold" />
                    <TextBox Grid.Row="7"
                             Grid.Column="0"
                             Margin="0,6,0,14"
                             Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="6"
                               Grid.Column="2"
                               Text="Exemples"
                               FontWeight="SemiBold" />
                    <TextBox Grid.Row="7"
                             Grid.Column="2"
                             Margin="0,6,0,14"
                             Height="84"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Text="{Binding ExampleSentencesText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="8"
                               Grid.Column="0"
                               Text="Synonymes"
                               FontWeight="SemiBold" />
                    <TextBox Grid.Row="9"
                             Grid.Column="0"
                             Margin="0,6,0,14"
                             Text="{Binding SynonymsText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="8"
                               Grid.Column="2"
                               Text="Tags"
                               FontWeight="SemiBold" />
                    <TextBox Grid.Row="9"
                             Grid.Column="2"
                             Margin="0,6,0,14"
                             Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="10"
                               Grid.Column="0"
                               Grid.ColumnSpan="3"
                               Text="Images (3 maximum)"
                               FontWeight="SemiBold" />
                    <StackPanel Grid.Row="11"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Margin="0,6,0,14">
                        <ItemsControl ItemsSource="{Binding Images}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,12,8" Width="96">
                                        <Grid>
                                            <Border x:Name="ImageThumbnailFrame"
                                                    Width="96"
                                                    Height="96"
                                                    BorderBrush="{DynamicResource Brush.Border.Strong}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Background="{DynamicResource Brush.Input.Background}">
                                                <!-- CornerRadius alone only rounds the Border's own
                                                     Background/BorderBrush painting — a child Image still
                                                     clips to a plain rectangle unless the Border's own Clip
                                                     is set to a matching rounded geometry. -->
                                                <Border.Clip>
                                                    <RectangleGeometry RadiusX="6" RadiusY="6">
                                                        <RectangleGeometry.Rect>
                                                            <MultiBinding Converter="{StaticResource SizeToRectConverter}">
                                                                <Binding ElementName="ImageThumbnailFrame" Path="ActualWidth" />
                                                                <Binding ElementName="ImageThumbnailFrame" Path="ActualHeight" />
                                                            </MultiBinding>
                                                        </RectangleGeometry.Rect>
                                                    </RectangleGeometry>
                                                </Border.Clip>
                                                <Image Source="{Binding ImageBase64, Converter={StaticResource Base64ImageConverter}}"
                                                       Stretch="Uniform" />
                                            </Border>
                                            <Button Content="✕"
                                                    Width="22" Height="22"
                                                    Padding="0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="0,-8,-8,0"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    ToolTip="Retirer cette image"
                                                    Command="{Binding RemoveCommand}" />
                                        </Grid>
                                        <TextBox Margin="0,6,0,0"
                                                 Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Légende de l'image" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Ajouter des images..."
                                Width="150"
                                HorizontalAlignment="Left"
                                Margin="0,4,0,0"
                                Click="AddImagesButton_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanAddMoreImages}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Row="12"
                               Grid.Column="0"
                               Grid.ColumnSpan="3"
                               Text="Notes personnelles"
                               FontWeight="SemiBold" />
                    <TextBox Grid.Row="13"
                             Grid.Column="0"
                             Grid.ColumnSpan="3"
                             Margin="0,6,0,0"
                             Height="70"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="14"
                               Grid.ColumnSpan="3"
                               Text="{Binding ErrorMessage}"
                               Margin="0,14,0,0"
                               Foreground="{DynamicResource Brush.Danger}"
                               FontWeight="SemiBold" />
                </Grid>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="2">
            <TextBlock Text="Les champs marqués d'un * sont requis."
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Annuler"
                        Width="96"
                        Margin="0,0,10,0"
                        IsCancel="True" />
                <Button Content="{Binding SaveButtonText}"
                        Width="110"
                        Style="{StaticResource AccentButtonStyle}"
                        IsDefault="True"
                        Command="{Binding SaveEntryCommand}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
