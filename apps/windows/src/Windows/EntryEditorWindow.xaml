<Window x:Class="LexiCall.Desktop.Windows.EntryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="860" Width="820"
        MinHeight="620" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI"
        Loaded="EntryEditorWindow_Loaded">
    <Window.Resources>
        <!-- Icon-only toggle for the per-field AI-enrichment lock (see
             EntryEditorWindowViewModel.IsDefinitionLocked etc.) — no implicit
             ToggleButton style exists app-wide, so this needs its own
             chrome-free template (same idea as Styles.xaml's
             TreeExpanderStyle) rather than the default WPF button look. -->
        <Style x:Key="FieldLockToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="ToolTip" Value="Exclure ce champ de l'enrichissement IA" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <!-- Open padlock by default (field free for AI
                                 enrichment); switches to closed + accent
                                 color once locked. -->
                            <Path x:Name="LockIcon"
                                  Data="{StaticResource Icon.Phosphor.lock-key-open}"
                                  Width="13" Height="13" Stretch="Uniform"
                                  Fill="{DynamicResource Brush.Text.Secondary}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="LockIcon" Property="Data" Value="{StaticResource Icon.Phosphor.lock-key}" />
                                <Setter TargetName="LockIcon" Property="Fill" Value="{DynamicResource Brush.Danger}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!--
        Modal add/edit entry form. Left column groups the text fields (word,
        definition, synonyms, examples, notes) in one uninterrupted flow;
        right column groups the lighter metadata (categories, type, source),
        with categories given the most vertical room since it's the field
        most worth showing without scrolling. Images sit in their own
        full-width section below both, so they don't split the text flow.
        The two columns are independent StackPanels, not a shared Grid with
        row-per-field: a shared Auto row stretches every cell in it to match
        its tallest sibling, which silently mis-sizes (and can overlap)
        unrelated fields in the other column.
        Categories are optional and picked via checkboxes, indented by their
        depth in the hierarchy.
    -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding HeaderText}"
                       FontSize="26"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding DescriptionText}"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,20,0,20"
                Padding="20,20,8,20"
                Style="{StaticResource CardBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Padding="0,0,24,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- ═══ Left column: the text fields, one flow ═══ -->
                        <StackPanel Grid.Column="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="{StaticResource Icon.Phosphor.book-bookmark}"
                                      Fill="{DynamicResource Brush.Text.Secondary}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Mot *" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="2"
                                        Padding="10,3"
                                        FontSize="12"
                                        ToolTip="Propose Définition/Type/Synonymes/Exemples via l'IA (nécessite une synchronisation API configurée)"
                                        Command="{Binding EnrichDraftCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanEnrichDraft}" Value="False">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Spun forever via its own Loaded trigger; only ever
                                             visible while IsEnrichingDraft is true. -->
                                        <Path Width="12" Height="12" Stretch="Uniform"
                                              Data="{StaticResource Icon.Phosphor.circle-half-tilt}"
                                              Margin="0,0,6,0"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </Path.RenderTransform>
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Text.Secondary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnrichingDraft}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                            <Path.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                From="0" To="360" Duration="0:0:0.8"
                                                                RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Path.Triggers>
                                        </Path>
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Enrichir" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnrichingDraft}" Value="True">
                                                            <Setter Property="Text" Value="Enrichissement en cours..." />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBox Margin="0,8,0,12"
                                     Text="{Binding Word, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="{Binding EnrichmentErrorMessage}"
                                       Margin="0,0,0,12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.Danger}"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasEnrichmentError}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="{StaticResource Icon.Solar.notebook}"
                                      Fill="{DynamicResource Brush.Text.Secondary}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Définition *" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ToggleButton Grid.Column="2"
                                              Style="{StaticResource FieldLockToggleStyle}"
                                              IsChecked="{Binding IsDefinitionLocked, Mode=TwoWay}" />
                            </Grid>
                            <TextBox Margin="0,8,0,20"
                                     Height="96"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     Text="{Binding Definition, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="{StaticResource Icon.Phosphor.book-open}"
                                      Fill="{DynamicResource Brush.Text.Secondary}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Synonymes" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ToggleButton Grid.Column="2"
                                              Style="{StaticResource FieldLockToggleStyle}"
                                              IsChecked="{Binding IsSynonymsLocked, Mode=TwoWay}" />
                            </Grid>
                            <TextBox Margin="0,8,0,20"
                                     Text="{Binding SynonymsText, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="{StaticResource Icon.Phosphor.quotes}"
                                      Fill="{DynamicResource Brush.Text.Secondary}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Exemples" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ToggleButton Grid.Column="2"
                                              Style="{StaticResource FieldLockToggleStyle}"
                                              IsChecked="{Binding IsExampleSentencesLocked, Mode=TwoWay}" />
                            </Grid>
                            <TextBox Margin="0,8,0,20"
                                     Height="96"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     Text="{Binding ExampleSentencesText, UpdateSourceTrigger=PropertyChanged}" />

                            <!-- Kept with the other text fields, not pushed after Images. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="{StaticResource Icon.Phosphor.note-pencil}"
                                      Fill="{DynamicResource Brush.Text.Secondary}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Notes personnelles" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                            <TextBox Margin="0,8,0,0"
                                     Height="90"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- ═══ Right column: lighter metadata ═══ -->
                        <StackPanel Grid.Column="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="{StaticResource Icon.Solar.tag}"
                                      Fill="{DynamicResource Brush.Text.Secondary}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Catégories" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,8,0,20">
                                <Border BorderBrush="{DynamicResource Brush.Border.Strong}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Background="{DynamicResource Brush.Input.Background}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAvailableCategories}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ListBox ItemsSource="{Binding CategorySelections}"
                                             Height="330"
                                             Padding="8"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                <Setter Property="Padding" Value="4,3" />
                                                <Setter Property="Margin" Value="0" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Name}"
                                                          Margin="{Binding Depth, Converter={StaticResource DepthToIndentConverter}}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>

                                <TextBlock Text="Aucune catégorie disponible. Tu peux en créer depuis le panneau latéral de la fenêtre principale."
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasAvailableCategories}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="{StaticResource Icon.Phosphor.shapes}"
                                      Fill="{DynamicResource Brush.Text.Secondary}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Type *" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ToggleButton Grid.Column="2"
                                              Style="{StaticResource FieldLockToggleStyle}"
                                              IsChecked="{Binding IsTypeLocked, Mode=TwoWay}" />
                            </Grid>
                            <Grid Margin="0,8,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding AvailableTypes}"
                                          DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedTypeOption, Mode=TwoWay}" />
                                <!-- Tucked beside Type rather than given its own section:
                                     a low-importance flag, not worth more visual weight. -->
                                <CheckBox Grid.Column="1"
                                          Content="Archivé"
                                          Margin="12,0,0,0"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsArchived}" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="{StaticResource Icon.Solar.document}"
                                      Fill="{DynamicResource Brush.Text.Secondary}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="Source" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                            <TextBox Margin="0,8,0,20"
                                     Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <!-- ═══ Images ═══ -->
                    <Separator Margin="0,4,0,16" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0"
                              Data="{StaticResource Icon.Phosphor.image}"
                              Fill="{DynamicResource Brush.Text.Secondary}"
                              Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="Images (4 maximum)" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding Images}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,14,10" Width="128">
                                        <Grid>
                                            <Border x:Name="ImageThumbnailFrame"
                                                    Width="128"
                                                    Height="104"
                                                    BorderBrush="{DynamicResource Brush.Border.Strong}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Background="{DynamicResource Brush.Input.Background}">
                                                <!-- CornerRadius alone only rounds the Border's own
                                                     Background/BorderBrush painting — a child Image still
                                                     clips to a plain rectangle unless the Border's own Clip
                                                     is set to a matching rounded geometry. -->
                                                <Border.Clip>
                                                    <RectangleGeometry RadiusX="6" RadiusY="6">
                                                        <RectangleGeometry.Rect>
                                                            <MultiBinding Converter="{StaticResource SizeToRectConverter}">
                                                                <Binding ElementName="ImageThumbnailFrame" Path="ActualWidth" />
                                                                <Binding ElementName="ImageThumbnailFrame" Path="ActualHeight" />
                                                            </MultiBinding>
                                                        </RectangleGeometry.Rect>
                                                    </RectangleGeometry>
                                                </Border.Clip>
                                                <Image Source="{Binding ImageBase64, Converter={StaticResource Base64ImageConverter}}"
                                                       Stretch="Uniform" />
                                            </Border>
                                            <Button Content="✕"
                                                    Width="22" Height="22"
                                                    Padding="0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="0,-8,-8,0"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    ToolTip="Retirer cette image"
                                                    Command="{Binding RemoveCommand}" />
                                        </Grid>
                                        <!-- Wraps across a few lines instead of scrolling sideways in a
                                             single-line box: captions are often full sentences. -->
                                        <TextBox Margin="0,6,0,0"
                                                 MinHeight="40"
                                                 MaxHeight="76"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Top"
                                                 Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Légende de l'image" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Ajouter des images..."
                                Width="150"
                                HorizontalAlignment="Left"
                                Margin="0,4,0,0"
                                Click="AddImagesButton_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanAddMoreImages}" Value="False">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Margin="0,14,0,0"
                               Foreground="{DynamicResource Brush.Danger}"
                               FontWeight="SemiBold" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="2">
            <TextBlock Text="Les champs marqués d'un * sont requis."
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Annuler"
                        Width="96"
                        Margin="0,0,10,0"
                        IsCancel="True" />
                <Button Content="{Binding SaveButtonText}"
                        Width="110"
                        Style="{StaticResource AccentButtonStyle}"
                        IsDefault="True"
                        Command="{Binding SaveEntryCommand}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
