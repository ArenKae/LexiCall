<Window x:Class="LexiCall.Desktop.Windows.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options"
        SizeToContent="WidthAndHeight"
        MinWidth="380" MaxWidth="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI">
    <!-- Options window (opened from the main window's gear button): theme
         toggle, API sync settings, and data folder access. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Options"
                   FontSize="22"
                   FontWeight="SemiBold" />

        <Border Grid.Row="1"
                Margin="0,18,0,0"
                Padding="16"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Apparence"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Thème clair ou sombre de l'application."
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="{Binding ThemeToggleText}"
                        Style="{StaticResource GhostButtonStyle}"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Click="ThemeToggleButton_Click"
                        ToolTip="Bascule entre le thème clair et le thème sombre." />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="16"
                Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Synchronisation API"
                           FontWeight="SemiBold" />
                <TextBlock Text="URL et clé du serveur api/ pour la synchronisation best-effort en tâche de fond. Laisser l'URL vide désactive la synchronisation."
                           Margin="0,4,0,10"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Text.Secondary}" />

                <TextBlock Text="URL de l'API" Margin="0,0,0,2" />
                <TextBox x:Name="ApiBaseUrlTextBox"
                         Margin="0,0,0,8" />

                <TextBlock Text="Clé API" Margin="0,0,0,2" />
                <TextBox x:Name="ApiKeyTextBox"
                         Margin="0,0,0,8" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ApiConnectionStatusText"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />

                    <Button Grid.Column="1"
                            Content="Tester la connexion"
                            Style="{StaticResource GhostButtonStyle}"
                            Margin="12,0,0,0"
                            Click="TestApiConnectionButton_Click"
                            ToolTip="Vérifie que l'API est joignable avec l'URL/la clé ci-dessus." />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Padding="16"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Données"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DataFilePath}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Ouvrir le dossier"
                        Style="{StaticResource GhostButtonStyle}"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Click="OpenDataFolderButton_Click"
                        ToolTip="Ouvre le dossier %LOCALAPPDATA%\LexiCall dans l'Explorateur." />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,22,0,0">
            <Button Content="Fermer"
                    Width="96"
                    IsCancel="True"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
