<Window x:Class="LexiCall.Desktop.Windows.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options"
        SizeToContent="WidthAndHeight"
        MinWidth="380" MaxWidth="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="Segoe UI">
    <!-- Options window -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Options"
                   FontSize="22"
                   FontWeight="SemiBold" />

        <Border Grid.Row="1"
                Margin="0,18,0,0"
                Padding="16"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Apparence"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Thème clair ou sombre de l'application."
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="{Binding ThemeToggleText}"
                        Style="{StaticResource GhostButtonStyle}"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Click="ThemeToggleButton_Click"
                        ToolTip="Bascule entre le thème clair et le thème sombre." />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Padding="16"
                Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Synchronisation API"
                           FontWeight="SemiBold" />
                <TextBlock Text="URL et clé du serveur api/ pour la synchronisation best-effort en tâche de fond. Laisser l'URL vide désactive la synchronisation."
                           Margin="0,4,0,10"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Text.Secondary}" />

                <TextBlock Text="URL de l'API" Margin="0,0,0,2" />
                <TextBox x:Name="ApiBaseUrlTextBox"
                         Margin="0,0,0,8" />

                <TextBlock Text="Clé API" Margin="0,0,0,2" />
                <TextBox x:Name="ApiKeyTextBox"
                         Margin="0,0,0,8" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ApiConnectionStatusText"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />

                    <Button Grid.Column="1"
                            Content="Tester la connexion"
                            Style="{StaticResource GhostButtonStyle}"
                            Margin="12,0,0,0"
                            Click="TestApiConnectionButton_Click"
                            ToolTip="Vérifie que l'API est joignable avec l'URL/la clé ci-dessus." />
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Renvoie toutes les modifications locales et retélécharge les données divergentes depuis le serveur."
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />

                    <Button x:Name="FullResyncButton"
                            Grid.Column="1"
                            Style="{StaticResource GhostButtonStyle}"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Click="FullResyncButton_Click"
                            ToolTip="Chaque enregistrement reste arbitré par date de modification : le plus récent des deux côtés gagne.">
                        <StackPanel Orientation="Horizontal">
                            <!-- Spinner and idle icon share the slot: each is
                                 visible exactly when the other is not. -->
                            <Path Width="13" Height="13" Stretch="Uniform"
                                  Data="{StaticResource Icon.Phosphor.circle-half-tilt}"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Path.RenderTransform>
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Text.Secondary}" />
                                        <Style.Triggers>
                                            <!-- Spun from the trigger, not from Loaded: a Forever
                                                 animation started on load never stops while the
                                                 dialog is open. -->
                                            <DataTrigger Binding="{Binding IsFullResyncing}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="FullResyncSpinner">
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                From="0" To="360" Duration="0:0:0.8"
                                                                RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="FullResyncSpinner" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>

                            <Path Data="{StaticResource Icon.Phosphor.arrows-counter-clockwise}"
                                  Width="13" Height="13"
                                  Stretch="Uniform"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Text.Secondary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFullResyncing}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>

                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Tout resynchroniser" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFullResyncing}" Value="True">
                                                <Setter Property="Text" Value="Resynchronisation…" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Padding="16"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Données"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DataFilePath}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Ouvrir le dossier"
                        Style="{StaticResource GhostButtonStyle}"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Click="OpenDataFolderButton_Click"
                        ToolTip="Ouvre le dossier %LOCALAPPDATA%\LexiCall dans l'Explorateur." />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,22,0,0">
            <Button Content="Fermer"
                    Width="96"
                    IsCancel="True"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
