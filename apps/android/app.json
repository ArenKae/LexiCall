{
  "expo": {
    "name": "LexiCall",
    "slug": "lexicall",
    "scheme": "lexicall",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/android-icon-foreground.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "fr.arenkae.lexicall",
      "adaptiveIcon": {
        "backgroundColor": "#FEF4E7",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FEF4E7",
          "dark": {
            "backgroundColor": "#201E1B"
          }
        }
      ]
    ]
  }
}
